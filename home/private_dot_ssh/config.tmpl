{{ if eq .chezmoi.os "darwin" -}}
Include ~/.orbstack/ssh/config

{{ end -}}
Include ~/.ssh/config.local

Host github.com
  User msageha
  IdentityFile ~/.ssh/git_msageha
  TCPKeepAlive yes
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new

Host gitlab.technoface.co.jp
  User git
  IdentityFile ~/.ssh/technoface/gitlab
  TCPKeepAlive yes
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
