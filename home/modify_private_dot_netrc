{{- /* chezmoi:modify-template */ -}}
{{- /*
  golang.flatt.tech の認証行を ~/.netrc の先頭に置き、ほかの行は温存する。Go は同じ machine の
  エントリが複数あると先頭を使い、`default` エントリ以降を読まないため、末尾ではなく先頭に置く。
  token が無い環境は .chezmoiignore で管理対象から外す。
*/ -}}
{{- $prefix := "machine golang.flatt.tech login token password " -}}
{{- $lines := list (printf "%s%s" $prefix (dig "apiKeys" "takumiGuard" "" .)) -}}
{{- $stdin := trimSuffix "\n" (dig "stdin" "" .chezmoi) -}}
{{- if $stdin -}}
{{-   range splitList "\n" $stdin -}}
{{-     if not (hasPrefix $prefix .) -}}
{{-       $lines = append $lines . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ join "\n" $lines }}
