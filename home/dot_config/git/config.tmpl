{{- /* delta は mise のモダン CLI 群 (config.toml.tmpl)、git-secrets は
     run_once_after_91_common.sh.tmpl で導入され、Windows はどちらも展開しない。
     存在しない環境で core.pager / init.templatedir が壊れないよう導入側と同じ条件で gate する */ -}}
{{- $hasCliTools := and (ne .chezmoi.os "windows") (not (dig "skip_cli_tools" false .)) -}}
[ghq]
    root = ~/Works/src

[user]
    name = Mizuki Sango
    email = msageha+git@gmail.com

[init]
    defaultBranch = main
{{- if $hasCliTools }}
    templatedir = ~/.config/git/templates/git-secrets

[secrets]
    providers = git secrets --aws-provider
    patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
    patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
    patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
    allowed = AKIAIOSFODNN7EXAMPLE
    allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
{{- end }}

[core]
    editor = vim
    excludesFile = ~/.config/git/ignore
{{- if $hasCliTools }}
    pager = delta
{{- end }}

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

[grep]
    lineNumber = true

[pull]
    ff = only

[fetch]
    # リモートで削除されたブランチの追跡 ref を fetch 時に掃除する
    prune = true

[submodule]
    # checkout/fetch/pull 等で --recurse-submodules を既定にする (clone は対象外)
    recurse = true

[color]
    ui = auto

# Dracula theme for Git (https://github.com/dracula/git の config/gitconfig をマージ。
# upstream の配布形式が「内容を自分の gitconfig へコピー」のため include ではなく直書き)
[color "branch"]
    current = cyan bold reverse
    local = white
    plain =
    remote = cyan

[color "diff"]
    commit =
    func = cyan
    plain =
    whitespace = magenta reverse
    meta = white
    frag = cyan bold reverse
    old = red
    new = green

[color "grep"]
    context =
    filename =
    function =
    linenumber = white
    match =
    selected =
    separator =

[color "interactive"]
    error =
    header =
    help =
    prompt =

[color "status"]
    added = green
    changed = yellow
    header =
    localBranch =
    nobranch =
    remoteBranch = cyan bold
    unmerged = magenta bold reverse
    untracked = red
    updated = green bold

[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    lg = log --oneline --graph --decorate
    lga = log --oneline --graph --decorate --all
    ls = ls-files
    cp = cherry-pick
    rb = rebase
    rbi = rebase -i
    rbc = rebase --continue

[diff]
    tool = vimdiff

[merge]
    tool = vimdiff
    conflictstyle = diff3
{{- if $hasCliTools }}

[interactive]
    diffFilter = delta --color-only

# dracula.gitconfig は .chezmoiexternal.toml が取得し、[delta "dracula"] を定義する
[include]
    path = ~/.config/delta/dracula/dracula.gitconfig

[delta]
    features = dracula
    side-by-side = true
{{- end }}

[push]
    default = current

[credential]
{{- if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
    # Git Credential Manager (Git for Windows 標準)。cache は unix ソケット前提で動かない
    helper = manager
{{- else }}
    helper = cache --timeout=3600
{{- end }}

[safe]
    directory = ~/.local/share/chezmoi

[includeIf "gitdir:~/.local/share/chezmoi/"]
    path = ~/.config/git/config.github

[includeIf "gitdir:~/Works/src/github.com/"]
    path = ~/.config/git/config.github
{{- /* 以下の include 先は age 鍵が無いと復号できないため、.chezmoiignore が同じ条件の否定で ignore する */ -}}
{{- $ageKey := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" }}
{{- if and (eq .chezmoi.os "darwin") (stat $ageKey) }}

[includeIf "gitdir:~/Works/src/gitlab.technoface.co.jp/"]
    path = ~/.config/git/config.technoface.gitlab

[includeIf "gitdir:~/Works/src/github.com/SakanaAIBusiness/"]
    path = ~/.config/git/config.sakanaai.github
[includeIf "gitdir:~/Works/src/github.com/SakanaAI/"]
    path = ~/.config/git/config.sakanaai.github
{{- end }}
