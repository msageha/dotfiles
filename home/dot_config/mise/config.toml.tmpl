{{ if eq .chezmoi.os "darwin" -}}
[plugins]
flutter = "https://github.com/mise-plugins/mise-flutter.git"
{{ end -}}

[settings.status]
show_env = true
show_tools = false

[tools]
{{/* 言語ランタイム は skip_cli_tools=false を明示した環境でのみ入れる */ -}}
{{/* / クラウド CLIは、macos かつ skip_cli_tools=false の環境でのみ入れる */ -}}
{{ if and (eq .chezmoi.os "darwin") (not (dig "skip_cli_tools" true .)) -}}
awscli = "2.36.27"
aws-sso = "2.3.2"
{{ end -}}
direnv = "2.37.1"
{{ if and (eq .chezmoi.os "darwin") (not (dig "skip_cli_tools" true .)) -}}
flutter = "3.47.1"
{{ end -}}
fzf = "0.74.3"
{{ if and (eq .chezmoi.os "darwin") (not (dig "skip_cli_tools" true .)) -}}
gcloud = "581.0.0"
{{ end -}}
ghq = "1.10.1"
{{ if not (dig "skip_cli_tools" true .) -}}
go = "1.27.0"
java = "temurin-26.0.1+8"
{{ end -}}
{{ if and (eq .chezmoi.os "darwin") (not (dig "skip_cli_tools" true .)) -}}
kubectl = "1.36.4"
{{ end -}}
{{ if not (dig "skip_cli_tools" true .) -}}
node = "26.7.0"
pnpm = "11.22.0"
{{/* LSP サーバー群 (Claude Code の LSP plugin が参照。go / node ランタイム前提) */ -}}
"go:golang.org/x/tools/gopls" = "0.23.0"
"npm:pyright" = "1.1.411"
# typescript-language-server は JS 版 tsserver 前提のため typescript 7 (native) ではなく 5 系に固定
"npm:typescript" = "5.9.3"
"npm:typescript-language-server" = "5.3.0"
{{ end -}}
starship = "1.26.0"
{{ if and (eq .chezmoi.os "darwin") (not (dig "skip_cli_tools" true .)) -}}
stern = "1.34.0"
terraform = "1.15.9"
terragrunt = "1.1.3"
{{ end -}}
{{ if not (dig "skip_cli_tools" false .) -}}
uv = "0.12.5"
{{/* モダンCLI ユーティリティ群 */ -}}
bat = "0.26.1"
delta = "0.19.2"
eza = "0.23.5"
fd = "10.4.2"
ripgrep = "15.2.0"
zoxide = "0.10.0"

duf = "0.9.1"
dust = "1.2.5"
"ubi:dalance/procs" = "0.14.12"
hexyl = "0.17.0"
fastfetch = "2.67.1"
tmux = "3.7b"
{{/* データ処理 ユーティリティ群 */ -}}
jq = "1.8.2"
yq = "4.53.6"
{{/* ServiceAccount ユーティリティ群 */ -}}
gh = "2.97.0"
glab = "1.114.0"
fnox = "1.33.1"
# fnox は補完生成 (completion fish/zsh/bash) 時に usage コマンドを内部で呼び出すため必須
usage = "5.1.0"
{{/* CLIツール ユーティリティ群 */ -}}
websocat = "1.14.1"
"ubi:boyter/scc" = "3.7.0"
"go:github.com/cloudflare/cloudflare-go/cmd/flarectl" = "0.117.0"
{{ end -}}
