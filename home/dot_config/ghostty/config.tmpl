# Theme
theme = "dracula"

# Font
font-family = "SauceCodePro Nerd Font"
font-family = "Source Han Code JP"
font-size = 18
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"

# Window
macos-titlebar-style = "transparent"
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-theme = "ghostty"

background-opacity = 0.98
background-blur-radius = 0

# Terminal
term = "xterm-256color"
# scrollback-limit の単位はバイト (行数ではない)。2MB。
# 注意: Ghostty の config はインラインコメント非対応 (値の後に # を書くと行ごと無視される)
scrollback-limit = 2000000

# Window Size
window-inherit-font-size = true
# maximize = true
window-height = 30
window-width = 999
quick-terminal-screen = main
quick-terminal-size = 75%
quick-terminal-position = top


# macOS Specific
macos-option-as-alt = false
macos-hidden = always

# Quick Terminal (Hotkey Window equivalent)
# iTerm2 Hotkey Window: transparency 30%, blur on (radius 2)
# keybind = global:alt+space=toggle_quick_terminal
# quick-terminal-animation-duration = 0

# command は非絶対パスなら PATH 解決されるが、macOS の GUI アプリは launchd の
# 最小 PATH で起動して fish を解決できないため、OS ごとの絶対パスを指定する
{{ if eq .chezmoi.os "darwin" -}}
command = /opt/homebrew/bin/fish
{{ else -}}
command = /usr/bin/fish
{{ end -}}
shell-integration = fish
clipboard-trim-trailing-spaces = true
shell-integration-features = no-cursor

unfocused-split-opacity = 0.30

# Mouse and Cursor
mouse-shift-capture = true
cursor-style = block
