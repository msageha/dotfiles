theme = "dracula"

font-family = "SauceCodePro Nerd Font"
font-family = "Source Han Code JP"
font-size = 18
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"

macos-titlebar-style = "transparent"
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-theme = "ghostty"

background-opacity = 0.98
background-blur-radius = 0

term = "xterm-256color"
# 単位はバイト (2MB)。Ghostty の config は行末コメントに対応せず、値の後に # を書くと行ごと無視される
scrollback-limit = 2000000

window-inherit-font-size = true
window-height = 30
window-width = 999

quick-terminal-screen = main
quick-terminal-size = 75%
quick-terminal-position = top

macos-option-as-alt = false
macos-hidden = always

# command は非絶対パスなら PATH 解決されるが、macOS の GUI アプリは launchd の
# 最小 PATH で起動して fish を解決できないため、OS ごとの絶対パスを指定する
{{ if eq .chezmoi.os "darwin" -}}
command = /opt/homebrew/bin/fish
{{ else -}}
command = /usr/bin/fish
{{ end -}}
shell-integration = fish
clipboard-trim-trailing-spaces = true
shell-integration-features = no-cursor

unfocused-split-opacity = 0.30

mouse-shift-capture = true
cursor-style = block
