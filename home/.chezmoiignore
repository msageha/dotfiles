{{- $ageKey := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" }}
# 業務用 git 設定 (config.sakanaai.github / config.technoface.gitlab) は age 秘密鍵が無いと復号できず、
# config.tmpl 側の includeIf も darwin 限定のため、いずれかに該当すれば ignore する
{{ if or (not (stat $ageKey)) (ne .chezmoi.os "darwin") }}
.config/git/config.*
!.config/git/config.github
{{ end }}
{{ if not (stat $ageKey) }}
.ssh/*
!.ssh/config
{{ end }}

# Windows では unix 向け dotfiles (シェル設定・vim・unix ツールの .config) は展開しない。
# git / ssh / starship / コーディングエージェント設定は Windows でも使うため管理を続ける
{{ if eq .chezmoi.os "windows" }}
.alias
.bash_profile
.zprofile
.config/shell
.config/tmux
.vimrc
.config/fastfetch
.config/fish
.config/gh
.config/htop
.config/mise
.config/ripgrep
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.config/gh/hosts.yml
{{ end }}

# ghostty は GUI アプリのため、GUI を導入しない環境では設定・テーマ (external) を展開しない。
# external にはディレクトリ単体のパターンだけでは効かないため /** も併記する
{{ if or (eq .chezmoi.os "windows") (dig "skip_gui_tools" false .) }}
.config/ghostty
.config/ghostty/**
{{ end }}

# コーディングエージェント設定 (.claude / .codex / .gemini / .grok / .claude.json / .config/agents) は
# unix は skip_cli_tools、Windows は skip_windows_extras で管理対象外にする (片方しか定義されないため or で拾う)。
# 管理するときも各ディレクトリは X/* で一度 ignore し、管理対象のトップレベル項目だけを ! で戻す
# (autoPush 環境で chezmoi add がランタイムファイルを取り込むのを防ぎ、source に残った迷子ファイルも展開しない)。
# X/* は深さ 1 にしか効かないため、配下のファイルまで ! で戻す必要はない
{{- $skipCodingAgent := or (dig "skip_cli_tools" false .) (dig "skip_windows_extras" false .) }}
{{ if $skipCodingAgent }}
.claude
.codex
.gemini
.grok
.claude.json
.config/agents
.config/agents/**
{{ end }}

.claude/*
{{ if not $skipCodingAgent }}
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/settings.fusion.json
!.claude/statusline-command.sh
!.claude/agents
!.claude/skills
!.claude/rules
{{ end }}
{{- /* gws-* skills は Homebrew の googleworkspace-cli 前提のため macOS 以外では展開しない */}}
{{ if ne .chezmoi.os "darwin" }}
.claude/skills/gws-*
.claude/skills/gws-*/**
{{ end }}

.codex/*
{{ if not $skipCodingAgent }}
!.codex/AGENTS.md
!.codex/config.toml
!.codex/fugu.config.toml
!.codex/fugu-cyber.config.toml
!.codex/fusion.config.toml
!.codex/pareto-code.config.toml
!.codex/fugu.json
!.codex/fugu-cyber.json
!.codex/fusion.json
!.codex/pareto-code.json
!.codex/.env
{{- /* auth.json は Codex CLI の credential store。OpenAI API key が注入された環境だけ管理し、
       鍵が空なら既存の login 状態を消したり空鍵で上書きしたりしないよう管理外にする */}}
{{ if dig "apiKeys" "openai" "" . }}
!.codex/auth.json
{{ end }}
!.codex/agents
!.codex/rules
{{ end }}

.gemini/*
{{ if not $skipCodingAgent }}
!.gemini/settings.json
!.gemini/.env
!.gemini/antigravity-cli
!.gemini/config
{{ end }}

# auth・sessions・logs 等のランタイム状態を含むため .grok/* を ignore する
.grok/*
{{ if not $skipCodingAgent }}
!.grok/AGENTS.md
!.grok/config.toml
!.grok/skills
{{ end }}
