{{- $ageKey := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" }}
# 業務用 git 設定 (config.sakanaai.github / config.technoface.gitlab) は age 秘密鍵が無いと復号できず、
# config.tmpl 側の includeIf も darwin 限定のため、いずれかに該当すれば ignore する
{{ if or (not (stat $ageKey)) (ne .chezmoi.os "darwin") }}
.config/git/config.*
!.config/git/config.github
{{ end }}
{{ if not (stat $ageKey) }}
.ssh/*
!.ssh/config
{{ end }}

# 1Password から取得する SSH 鍵 (.chezmoidata.toml の ssh_keys) は、通常の status / diff / apply で op read が走らないよう、
# apply_ssh_keys が true の実行 (mise run apply-ssh-keys と install/common/secrets.sh が --override-data で渡す) 以外では ignore する。
# 子が全て ignore でも親ディレクトリは作られるため、サブディレクトリも列挙する。apply_ssh_keys は bool の true と比較する (文字列を渡すと template error)。
# Windows は private_ 属性で NTFS ACL を制御できないため常に ignore する
{{ if or (eq .chezmoi.os "windows") (ne (dig "apply_ssh_keys" false .) true) }}
{{-   range .ssh_keys.items }}
{{-     if ne (dir .path) "." }}
.ssh/{{ dir .path }}
{{-     end }}
.ssh/{{ .path }}
.ssh/{{ .path }}.pub
{{-   end }}
{{ end }}

# Windows では unix 向けの dotfiles (シェル設定・vim・unix ツールの .config) を展開しない
# (git / ssh / starship / コーディングエージェント設定は Windows でも使う)
{{ if eq .chezmoi.os "windows" }}
.alias
.bash_profile
.zprofile
.config/shell
.config/tmux
.vimrc
.config/fastfetch
.config/fish
.config/gh
.config/htop
.config/mise
.config/ripgrep
{{ end }}

# self-hosted runner の実行ユーザー (runner) には個人用の mise / git 設定を展開しない。
# global の mise の [tools] / [plugins] が CI の mise に混入して install が失敗し、
# git は個人の identity と credential helper が共有 runner に残るため。
# GitHub-hosted runner も実行ユーザーが runner なので、GitHub Actions の job 内 (GITHUB_ACTIONS が立つ) は除く。
{{ if and (eq .chezmoi.username "runner") (not (env "GITHUB_ACTIONS")) }}
.config/mise
.config/git
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.config/gh/hosts.yml
{{ end }}

# Takumi Guard (悪性パッケージを遮断するパッケージレジストリ) の設定 (npm / pip / uv / Go)。Windows は設定ファイルの配置先が異なるため対象外。
# パッケージマネージャーを入れない構成 (skip_cli_tools) でも展開せず、Go の token を置く .netrc は token が無ければ触らない
{{ if or (eq .chezmoi.os "windows") (dig "skip_cli_tools" false .) }}
.npmrc
.netrc
.config/pip
.config/uv
{{ else if not (dig "apiKeys" "takumiGuard" "" .) }}
.netrc
{{ end }}

# ghostty は GUI アプリのため、GUI を導入しない環境では設定・テーマ (external) を展開しない。
# external にはディレクトリ単体のパターンだけでは効かないため /** も併記する
{{ if or (eq .chezmoi.os "windows") (dig "skip_gui_tools" false .) }}
.config/ghostty
.config/ghostty/**
{{ end }}

# コーディングエージェント設定 (.claude / .codex / .gemini / .grok / .agents / .claude.json / .config/agents) は
# unix は skip_cli_tools、Windows は skip_windows_extras で管理対象外にする (片方しか定義されないため or で拾う)。
# 管理するときも各ディレクトリを X/* で ignore し、管理する直下の項目だけを ! で戻す (chezmoi add がランタイムファイルを
# source に取り込んで autoPush するのを防ぎ、source に残った不要ファイルも展開しない)。X/* は直下にしか効かないので、戻した項目の配下は戻さなくてよい
{{- $skipCodingAgent := or (dig "skip_cli_tools" false .) (dig "skip_windows_extras" false .) }}
{{ if $skipCodingAgent }}
.claude
.codex
.gemini
.grok
.agents
.claude.json
.config/agents
.config/agents/**
{{ end }}

.claude/*
{{ if not $skipCodingAgent }}
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/statusline-command.sh
!.claude/agents
!.claude/skills
!.claude/rules
{{- /* ignore に一致するパスには .chezmoiremove が効かないため、.chezmoiremove で消すファイルを外す */}}
!.claude/settings.fusion.json
{{ end }}
{{- /* gws-* skills は Homebrew の googleworkspace-cli 前提のため macOS 以外では展開しない */}}
{{ if ne .chezmoi.os "darwin" }}
.claude/skills/gws-*
.claude/skills/gws-*/**
{{ end }}

.codex/*
{{ if not $skipCodingAgent }}
!.codex/AGENTS.md
!.codex/config.toml
!.codex/fugu.config.toml
!.codex/fugu-cyber.config.toml
!.codex/fugu.json
!.codex/fugu-cyber.json
!.codex/.env
!.codex/agents
!.codex/rules
{{- /* .chezmoiremove で消すファイル */}}
!.codex/fusion.config.toml
!.codex/fusion.json
!.codex/pareto-code.config.toml
!.codex/pareto-code.json
{{ end }}

.gemini/*
{{ if not $skipCodingAgent }}
!.gemini/settings.json
{{- /* .chezmoiremove で消すファイル */}}
!.gemini/.env
!.gemini/antigravity-cli
!.gemini/config
{{ end }}

.grok/*
{{ if not $skipCodingAgent }}
!.grok/AGENTS.md
!.grok/config.toml
{{ end }}

# ~/.agents/skills は Codex が読む共有 skill の配置先 (Grok も読む)
.agents/*
{{ if not $skipCodingAgent }}
!.agents/skills
{{ end }}
