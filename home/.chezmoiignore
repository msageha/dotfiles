{{- $ageKey := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" }}
# age 秘密鍵が無い環境では暗号化ファイルをignoreに設定
{{ if not (stat $ageKey) }}
.gitconfig.*
!.gitconfig.github
.ssh/*
!.ssh/config
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.gitconfig.technoface.gitlab
.gitconfig.sakanaai.github
{{ end }}

# Windows では unix 向け dotfiles (シェル設定・vim・unix ツールの .config) は展開しない。
# git / ssh / starship / コーディングエージェント設定は Windows でも使うため管理を続ける。
{{ if eq .chezmoi.os "windows" }}
.alias
.bash_profile
.zprofile
.tmux.conf
.vimrc
# .vim / .config/delta / .tmux / .config/dircolors は .chezmoiexternal.toml の
# external (dracula テーマ) の展開先。
# external にはディレクトリ単体のパターンだけでは効かないため /** も併記する
.vim
.vim/**
.config/delta
.config/delta/**
.tmux
.tmux/**
.config/dircolors
.config/dircolors/**
.config/fastfetch
.config/fish
.config/gh
.config/htop
.config/mise
.config/ripgrep
{{ end }}

# ghostty は GUI アプリのため、GUI を導入しない環境では設定・テーマを展開しない
{{ if or (eq .chezmoi.os "windows") (dig "skip_gui_tools" false .) }}
.config/ghostty
.config/ghostty/**
{{ end }}

# .claude / .codex / .gemini / .grok (コーディングエージェント設定) は
# macOS / Linux で skip_cli_tools=true
# Windows で skip_windows_extras=true
# のとき管理対象外にする
{{- /* unix は skip_cli_tools、Windows は skip_windows_extras のみ定義されるため or で片方を拾う。
     キー未定義の旧 config でも動くよう dig のフォールバック形を使う (CLAUDE.md の規約) */}}
{{- $skipCodingAgent := or (dig "skip_cli_tools" false .) (dig "skip_windows_extras" false .) }}

# Ignore everything under .claude/ by default
.claude/*
{{ if not $skipCodingAgent }}
# Manage only these files
!.claude/CLAUDE.md
# CLAUDE-FABLE-5.md は廃止済み。ignore された target には .chezmoiremove が効かないため、
# 全マシンで削除が済むまで whitelist に残して remove を発火させる (掃除用の暫定エントリ)
!.claude/CLAUDE-FABLE-5.md
!.claude/settings.json
!.claude/settings.fusion.json
!.claude/statusline-command.sh
!.claude/agents
!.claude/agents/**
{{ if eq .chezmoi.os "darwin" }}
!.claude/skills
!.claude/skills/**
{{ else }}
!.claude/skills
{{- range glob (joinPath .chezmoi.sourceDir "dot_claude/skills/*") }}
{{- $name := base . }}
{{- if not (hasPrefix "gws-" $name) }}
!.claude/skills/{{ $name }}
!.claude/skills/{{ $name }}/**
{{- end }}
{{- end }}
{{ end }}
!.claude/rules
!.claude/rules/**
{{ end }}
{{- /* gws-* skills は Homebrew の googleworkspace-cli 前提のため macOS 以外では展開しない。 */}}
{{ if ne .chezmoi.os "darwin" }}
.claude/skills/gws-*
.claude/skills/gws-*/**
{{ end }}
# .claude.json (Claude MCP 設定) も skip_coding_agent=true のとき除外する
{{ if $skipCodingAgent }}
.claude.json
{{ end }}
{{ if $skipCodingAgent }}
.config/agents
.config/agents/**
{{ end }}
# Ignore everything under .codex/ by default
.codex/*
{{ if not $skipCodingAgent }}
!.codex/AGENTS.md
!.codex/config.toml
!.codex/fugu.config.toml
!.codex/fugu-cyber.config.toml
!.codex/fusion.config.toml
!.codex/pareto-code.config.toml
!.codex/fugu.json
!.codex/fugu-cyber.json
!.codex/fusion.json
# owl-alpha.json は廃止済み。上の CLAUDE-FABLE-5.md と同じく .chezmoiremove 発火用の暫定エントリ
!.codex/owl-alpha.json
!.codex/pareto-code.json
!.codex/.env
!.codex/agents
!.codex/agents/**
!.codex/rules
!.codex/rules/**
{{ end }}
# Ignore everything under .gemini/ by default
.gemini/*
{{ if not $skipCodingAgent }}
!.gemini/settings.json
!.gemini/.env
!.gemini/antigravity-cli
!.gemini/antigravity-cli/settings.json
!.gemini/config
!.gemini/config/AGENTS.md
!.gemini/config/mcp_config.json
!.gemini/config/agents
!.gemini/config/agents/**
!.gemini/config/skills
!.gemini/config/skills/**
{{ end }}
# Ignore everything under .grok/ by default (auth・sessions・logs 等のランタイム状態を除外)
.grok/*
{{ if not $skipCodingAgent }}
!.grok/AGENTS.md
!.grok/config.toml
!.grok/skills
!.grok/skills/**
{{ end }}
