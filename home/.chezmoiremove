{{ if ne .chezmoi.os "windows" -}}
{{- /* dracula テーマの展開先を ~/.vim / ~/.tmux から ~/.local/share/{vim,tmux} へ移行したため、
       旧 external が置いた ~/.vim / ~/.tmux を掃除する */}}
.vim
.tmux
{{- /* tmux の設定ファイルを ~/.tmux.conf から ~/.config/tmux/tmux.conf へ移行したため、
       旧 ~/.tmux.conf を掃除する (残したままだと tmux が両方読み込んでしまう) */}}
.tmux.conf
{{ $fontDir := ".local/share/fonts" }}
{{- if eq .chezmoi.os "darwin" }}{{ $fontDir = "Library/Fonts" }}{{ end }}
{{ $fontDir }}/SauceCodeProNerdFont*.ttf
{{ $fontDir }}/SymbolsNerdFont*.ttf
{{ $fontDir }}/SourceHanCodeJP-*.otf
{{ $fontDir }}/* for Powerline.ttf
{{ $fontDir }}/* for Powerline.otf
{{ $fontDir }}/* For Powerline.ttf
{{ $fontDir }}/* For Powerline.otf
{{ $fontDir }}/PowerlineSymbols.otf
{{ $fontDir }}/PowerlineExtraSymbols.otf
{{- /* ghostty 設定は chezmoi 管理 (~/.config/ghostty/config) へ移行済み。
       旧 installer (install/common/ghostty.sh、廃止) と旧 external が置いた残骸を掃除する。
       AppSupport はアプリの状態も置かれうるためディレクトリごとではなくファイル単位で消す */}}
{{- if eq .chezmoi.os "darwin" }}
Library/Application Support/com.mitchellh.ghostty/config.ghostty
Library/Application Support/com.mitchellh.ghostty/themes/dracula
{{- else }}
.config/ghostty/config.ghostty
{{- end }}
{{ end -}}
