  "hooks": {
{{- /* 以下の hooks は POSIX シェル + jq 前提。ネイティブ Windows では毎回エラー (exit≠2 で fail-open) になるだけなので設定しない */}}
{{- if ne .chezmoi.os "windows" }}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(cat | jq -r '.tool_input.command' | tr -d \"'\\\"\"); if printf '%s\\n' \"$CMD\" | grep -qiE '(^|[;&|(`])[[:space:]]*((sudo|env)[[:space:]]+)*(([^;&|[:space:]]*/)?rm[[:space:]]+(-{1,2}[[:alnum:]=-]+[[:space:]]+)*(-[[:alpha:]]*r[[:alpha:]]*|--recursive)([[:space:]]+-{1,2}[[:alnum:]=-]+)*[[:space:]]+(/|~|\\$HOME|\\*|\\.\\.?(/|[[:space:]]|$))|git[[:space:]]+reset[[:space:]]+--hard|git[[:space:]]+push[[:space:]]+(.*[[:space:]])?(-f|--force)([[:space:]]|$)|chmod[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*0?(777|000)([[:space:]]|/|$)|killall[[:space:]]+(finder|dock|systemuiserver|windowserver|loginwindow|kernel_task|launchd|cfprefsd)|(mysql|psql|mariadb|sqlite3|mysqlsh)[[:space:]].*drop[[:space:]]+table)' ; then echo \"BLOCKED: Dangerous command: $CMD\" >&2; exit 2; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "LOG=~/.claude/command-audit.log; if [ -f \"$LOG\" ] && [ \"$(wc -c < \"$LOG\")\" -gt 10485760 ]; then mv -f \"$LOG\" \"$LOG.1\"; fi; cat | jq -c '{timestamp: (now | todate), command: .tool_input.command}' >> \"$LOG\"; chmod 600 \"$LOG\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
{{- /* osascript は macOS 専用 */}}
{{- if eq .chezmoi.os "darwin" }}
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then ROLE=$(tmux display-message -t \"$TMUX_PANE\" -p '#{@role}' 2>/dev/null); if [ \"$ROLE\" = \"planner\" ] || [ \"$ROLE\" = \"worker\" ]; then exit 0; fi; fi; osascript -e 'display notification \"Claude Code が入力待ちです\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
{{- end }}
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); if printf '%s' \"$INPUT\" | jq -e '.stop_hook_active == true' >/dev/null 2>&1; then exit 0; fi; if [ -x .claude/verify.sh ]; then bash .claude/verify.sh >&2 || exit 2; fi",
            "timeout": 600
          }
        ]
      }
    ]
{{- end }}
