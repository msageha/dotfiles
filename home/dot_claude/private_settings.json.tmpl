{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {{ .claude.plugins | toPrettyJson | indent 2 | trim }},
{{- $marketplaces := dict }}
{{- range $name, $repo := .claude.marketplaces }}
{{-   $_ := set $marketplaces $name (dict "source" (dict "source" "github" "repo" $repo)) }}
{{- end }}
  "extraKnownMarketplaces": {{ $marketplaces | toPrettyJson | indent 2 | trim }},
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "fallbackModel": [],
  "switchModelsOnFlag": false,
  "skipDangerousModePermissionPrompt": true,
  "model": "claude-opus-5-5",
  "includeGitInstructions": false,
  "language": "japanese",
{{- /* この repo の home/dot_claude/CLAUDE.md (~/.claude/CLAUDE.md の source) は、repo での作業中に nested の CLAUDE.md として読み込まれ、
       適用済みの ~/.claude/CLAUDE.md と重複する (編集中は未 apply の下書きが指示として入る)。パターンは絶対パスに照合され、相対パスは一致しない */}}
  "claudeMdExcludes": ["**/home/dot_claude/CLAUDE.md"],
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_AUTO_COMPACT": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
{{- if dig "apiKeys" "sonatypeGuide" "" . }}
    "SONATYPE_GUIDE_TOKEN": "{{ dig "apiKeys" "sonatypeGuide" "" . }}",
{{- end }}
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000"
  },
  "skipWebFetchPreflight": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
{{- /* statusline-command.sh は bash 前提のため、ネイティブ Windows では statusLine を設定しない */}}
{{- if ne .chezmoi.os "windows" }}
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
{{- end }}
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": ["*"],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Desktop",
        "~/Downloads",
        "~/Works",
        "~/.local/share/chezmoi",
        "~/.config",
        "~/.cache",
        "~/.local/share/uv",
        "/tmp",
        "/private/tmp"
      ],
{{- /* permissions.deny の Read は sandbox の read の deny にも入る。入ったままだと、sandbox の中の chezmoi は設定を開けずに失敗し、
       uv / pip は開けない設定を黙って飛ばして既定の index を使い、claude は自分の設定を読めない。
       各ツールが自分の設定として読むファイルは、file tool からだけ隠すため、同じパスを sandbox の中のコマンドに開け直す
       (開け直したパスは、sandbox の中の `cat` 等からも読める)。
       同じパスの allowRead が deny に勝つことは公式 docs に記載が無く、Claude Code 2.1.325 (macOS) の実装で確かめた挙動に依る。
       sandbox の中で chezmoi が設定を開けなくなったら (uv / pip は失敗せず既定の index に落ちる)、この対を見直す。
       chezmoi の age 鍵 (`~/.config/chezmoi/key.txt`) は開け直さない。鍵は暗号化した target の復号に使い、`.chezmoiignore` と一部の template が
       有無を `stat` で見る。`.chezmoiignore` を通る `chezmoi apply` / `diff` / `status` は、開け直しても sandbox の中では動かない (deny した
       `~/.codex/.env`・`~/.gemini/.env` を lstat できない)。開け直さないので、鍵を `stat` する template の `chezmoi execute-template` は
       sandbox の中で失敗する */}}
      "allowRead": [
        "~/.config/pip/pip.conf",
        "~/.config/uv/uv.toml",
        "~/.config/chezmoi/chezmoi.toml",
        "~/.claude/settings.json",
        "~/.claude.json",
        "~/.claude-private/.claude.json",
        "~/.gemini/settings.json",
        "~/.gemini/config/mcp_config.json"
      ]
    }
  },
  "permissions": {
{{- /* python / node / xargs / timeout / env / source / rm / curl は許可プロンプトの大半を占めるため、危険度より効率を優先して許可する
       (rm は、最初の対象が / ~ $HOME * . .. の再帰削除を PreToolUse hook が止める前提)。sh / bash / zsh / fish は `bash -c '…'` で hook を
       素通りさせるため、secret に触る fnox / security / gpg / aws-vault とともに許可しない。
       auto mode では wildcard 付きの interpreter の allow は無視され classifier が判定する (default / acceptEdits では効く)。
       パスや環境変数の値の違いは `*` でまとめる (`*` は空白を含む任意の文字列に一致し、`VAR=* cmd` は `VAR=x PATH=/evil cmd` も通すが許容する)。
       先頭の `*` (その文字列を含む任意のコマンドに一致) と、`bash` とスクリプトパスの間の `*` (`bash -c '…' path` に一致) は使わない */}}
