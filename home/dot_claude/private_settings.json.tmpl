  "hooks": {
{{- /* 以下の hooks は POSIX シェルと jq に依存するため、ネイティブ Windows には設定しない */}}
{{- if ne .chezmoi.os "windows" }}
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_ENV_FILE\" ]; then printf '%s\\n' '. \"$HOME/.config/shell/agent-env.sh\"' >> \"$CLAUDE_ENV_FILE\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
{{- /* PreToolUse の遮断はスクリプトのファイルへ分けずここに書く。ファイルは許可している rm で消せ、hook のコマンドが
       exit 2 以外で失敗しても tool の実行は止まらないので、消えると遮断が黙って外れるため */}}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(cat | jq -r '.tool_input.command' | tr -d \"'\\\"\"); if printf '%s\\n' \"$CMD\" | grep -qiE '(^|[;&|(`])[[:space:]]*(((sudo|env|nohup|time|nice|command|exec|xargs|timeout)([[:space:]]+(-{1,2}[^[:space:]]+|[0-9]+(\\.[0-9]+)?[smhd]?))*|[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*)[[:space:]]+)*(([^;&|[:space:]]*/)?rm[[:space:]]+(-{1,2}[[:alnum:]=-]+[[:space:]]+)*(-[[:alpha:]]*r[[:alpha:]]*|--recursive)([[:space:]]+-{1,2}[[:alnum:]=-]+)*[[:space:]]+(/|~|\\$HOME|\\*|\\.\\.?(/|[[:space:]]|$))|git[[:space:]]+reset[[:space:]]+--hard|git[[:space:]]+push[[:space:]]+(.*[[:space:]])?(-f|--force)([[:space:]]|$)|git[[:space:]]+clean[[:space:]]+(-{1,2}[[:alnum:]-]+[[:space:]]+)*(-[[:alpha:]]*f[[:alpha:]]*|--force)|chmod[[:space:]]+(-[[:alpha:]]+[[:space:]]+)*0?(777|000)([[:space:]]|/|$)|killall[[:space:]]+(finder|dock|systemuiserver|windowserver|loginwindow|kernel_task|launchd|cfprefsd)|(mysql|psql|mariadb|sqlite3|mysqlsh)[[:space:]].*drop[[:space:]]+(table|database)|dropdb([[:space:]]|$))' ; then echo \"BLOCKED: Dangerous command: $CMD\" >&2; exit 2; fi",
            "timeout": 5
          }
        ]
      },
{{- /* EnterWorktree を path 無しで呼ぶと worktree が `.claude/worktrees/` に作られる。CLI が読む置き場所の設定キーは無く、WorktreeCreate hook は
       作成処理の全体を置き換える (`.worktreeinclude` の複写と片付けを自前で持つことになる) ので使わない。作業場所の worktree は
       共通規約どおり `git worktree add` で `.worktrees/<name>` に作らせ、既存の worktree へ path で入る形だけを通す。tool ごと deny にすると、
       sandbox の中から書ける session 自身の worktree にする手段が無くなる */}}
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "if ! cat | jq -e '.tool_input.path // empty | length > 0' >/dev/null 2>&1; then echo 'BLOCKED: EnterWorktree without path creates the worktree under .claude/worktrees/. Create it with git worktree add .worktrees/<name>, then follow the worktree notes in the user CLAUDE.md (enter it by passing that directory as path, or work in it without entering).' >&2; exit 2; fi",
            "timeout": 5
          }
        ]
      }
    ],
{{- /* osascript は macOS 専用 */}}
{{- if eq .chezmoi.os "darwin" }}
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then ROLE=$(tmux display-message -t \"$TMUX_PANE\" -p '#{@role}' 2>/dev/null); if [ \"$ROLE\" = \"planner\" ] || [ \"$ROLE\" = \"worker\" ]; then exit 0; fi; fi; osascript -e 'display notification \"Claude Code が入力待ちです\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
{{- end }}
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "LOG=~/.claude/command-audit.log; if [ -f \"$LOG\" ] && [ \"$(wc -c < \"$LOG\")\" -gt 10485760 ]; then mv -f \"$LOG\" \"$LOG.1\"; fi; cat | jq -c '{timestamp: (now | todate), command: .tool_input.command}' >> \"$LOG\"; chmod 600 \"$LOG\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
{{- end }}
  }
}
