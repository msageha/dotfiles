      "Read(~/.config/chezmoi/key.txt)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude.json)",
{{- /* Claude Code が ~/.claude.json の写しを置く場所。`~/.claude/backups/` は `Read(~/.claude/**)` の allow に入るので、deny しないと同じ中身を確認なしで読める */}}
      "Read(~/.claude.json.backup)",
      "Read(~/.claude/backups/**)",
      "Read(~/.codex/.env)",
      "Read(~/.gemini/.env)",
      "Read(~/.gemini/settings.json)",
      "Read(~/.gemini/config/mcp_config.json)",
{{- /* shell・REPL・DB クライアントの履歴 (入力したパスワードや token が残りうる)。shell を経ずに起動したツールは $HOME 直下の既定の場所に書き、
       shell (dot_config/shell/env.sh・dot_config/fish/config.fish) から起動したものは ~/.local/state に書く */}}
      "Read(~/.*_history)",
      "Read(~/.local/state/*_history)",
      "Read(~/.local/share/fish/fish_history)",
{{- /* .zshrc が HISTFILE を設定する前に macOS の /etc/zshrc が使う ${ZDOTDIR:-$HOME}/.zsh_history */}}
      "Read(~/.config/zsh/.zsh_history)",
{{- /* macOS の Terminal.app が zsh の履歴をセッションごとに写す場所 (/etc/zshrc_Apple_Terminal の ${ZDOTDIR:-$HOME}/.zsh_sessions) */}}
      "Read(~/.zsh_sessions/**)",
      "Read(~/.config/zsh/.zsh_sessions/**)",
      "Read(~/.claude/.credentials.json)",
{{- /* claude-private (CLAUDE_CONFIG_DIR=~/.claude-private) の同じ役割のファイル。settings.json は ~/.claude/settings.json への symlink */}}
      "Read(~/.claude-private/settings.json)",
      "Read(~/.claude-private/.claude.json)",
      "Read(~/.claude-private/backups/**)",
      "Read(~/.claude-private/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.codex-private/auth.json)",
      "Read(~/.grok/auth.json)",
{{- /* 復号した credential を標準出力に出す */}}
      "Bash(gws auth export:*)"
    ],
