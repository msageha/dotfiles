    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
{{- /* 値を持たない雛形は secret ではないので、.env 系の deny から外す。`!` (gitignore の否定) は、同じ設定ファイルの deny で
       前に並ぶ cwd 相対の rule だけを打ち消すので、上の rule より後ろに置く。managed settings など別の設定ファイルが `.env.*` を deny している環境では効かず、
       雛形は読めないままになる。否定が sandbox の read の deny にも効くかは公式 docs に記載が無く、sandbox の中のコマンドからは
       雛形を読めないままになりうる */}}
      "Read(!.env.template)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(**/.envrc)",
      "Read(**/secrets/**)",
      "Read(**/terraform.tfvars)",
      "Read(**/*.auto.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
