      "Edit(//private/tmp/**)",
      "Edit(//var/folders/*/*/T/**)",
      "Edit(//private/var/folders/*/*/T/**)",
      "Read(~/.claude/**)",
      "Read(~/.config/agents/**)",
      "Read(//Library/Application Support/ClaudeCode/**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Read(//var/folders/*/*/T/**)",
      "Read(//private/var/folders/*/*/T/**)",
      "Read(//opt/homebrew/**)",
      "Read(//Applications/**)",
      "Read(~/Desktop/**)",
      "Read(~/Downloads/**)",
      "Read(~/.local/share/mise/**)",
      "Read(~/.local/state/mise/**)",
      "Read(~/.config/mise/**)",
      "Read(~/.config/fish/**)",
      "Read(~/.cache/pre-commit/**)",
      "Read(~/.pub-cache/**)",
      "Read(~/.codex/**)",
      "Skill",
      "WebSearch",
      "WebFetch",
      "mcp__context7__*",
      "mcp__plugin_github_github__*",
