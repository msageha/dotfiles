{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "sonatype-guide@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "fallbackModel": [],
  "switchModelsOnFlag": false,
  "skipDangerousModePermissionPrompt": true,
  "model": "fable",
  "includeGitInstructions": false,
  "language": "japanese",
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_AUTO_COMPACT": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
{{- /* 空文字の ANTHROPIC_API_KEY は「キー設定済み」と解釈され authMethod: none で認証が落ちるため、
       鍵未配置の環境ではキー自体を出力しない (出力すると /login の OAuth にフォールバックできない) */}}
{{- if dig "apiKeys" "anthropic" "" . }}
    "ANTHROPIC_API_KEY": "{{ dig "apiKeys" "anthropic" "" . }}",
{{- end }}
    "SONATYPE_GUIDE_TOKEN": "{{ dig "apiKeys" "sonatypeGuide" "" . }}"
  },
  "skipWebFetchPreflight": true,
  "skipWorkflowUsageWarning": true,
  "tui": "fullscreen",
{{- /* statusline-command.sh は bash 前提のため、ネイティブ Windows では statusLine を設定しない */}}
{{- if ne .chezmoi.os "windows" }}
  "statusLine": {
    "type": "command",
    "command": "bash '{{ .chezmoi.homeDir }}/.claude/statusline-command.sh'"
  },
{{- end }}
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": ["*"],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        ".",
        "~/Desktop",
        "~/Downloads",
        "~/Works",
        "~/.local/share/chezmoi",
        "~/.config",
        "~/.cache",
        "~/.local/share/uv",
        "/tmp",
        "/private/tmp"
