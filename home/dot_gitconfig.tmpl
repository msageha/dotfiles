{{- /* delta は mise のモダンCLI群 (config.toml.tmpl) で導入される。
     Windows は .config/mise を展開しないため、delta が存在しない環境で
     core.pager が壊れないよう mise 側と同じ条件で gate する */ -}}
{{- $useDelta := and (ne .chezmoi.os "windows") (not (dig "skip_cli_tools" false .)) -}}
{{- /* git-secrets は run_once_after_91_common.sh.tmpl → install/common/git_secrets.sh で導入される。 */ -}}
{{- $useGitSecrets := and (ne .chezmoi.os "windows") (not (dig "skip_cli_tools" false .)) -}}
[ghq]
    root = ~/Works/src                    # GHQのルートディレクトリを指定
    shallow = true

[user]
    name = Mizuki Sango                   # Gitで使用するユーザー名
    email = msageha+git@gmail.com         # Gitで使用するメールアドレス

[init]
    defaultBranch = main                  # 新規リポジトリのデフォルトブランチ名を設定
{{- if $useGitSecrets }}
    templatedir = ~/.git-templates/git-secrets

[secrets]
    providers = git secrets --aws-provider
    patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
    patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
    patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
    allowed = AKIAIOSFODNN7EXAMPLE
    allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
{{- end }}

[core]
    editor = vim                          # デフォルトエディタをVimに設定
    excludesFile = ~/.gitignore           # グローバルな.gitignoreファイルの指定
{{- if $useDelta }}
    pager = delta                         # diff/log等のページャにdeltaを使用
{{- end }}

[filter "lfs"]
    smudge = git-lfs smudge -- %f         # LFSファイルの読み込み時の処理
    process = git-lfs filter-process      # LFSファイルのフィルタ処理
    required = true                       # LFSを必須に設定
    clean = git-lfs clean -- %f           # LFSファイルの保存時の処理

[grep]
    lineNumber = true                     # grep結果に行番号を表示

[pull]
    ff = only                             # fast-forward可能なときのみpullを許可

[fetch]
    prune = true                          # リモートで削除されたブランチの追跡refをfetch時に掃除

[color]
    ui = auto                             # 色の自動設定

# Dracula theme for Git (https://github.com/dracula/git の config/gitconfig をマージ。
# upstream の配布形式が「内容を自分の gitconfig へコピー」のため include ではなく直書き)
[color "branch"]
    current = cyan bold reverse
    local = white
    plain =
    remote = cyan

[color "diff"]
    commit =
    func = cyan
    plain =
    whitespace = magenta reverse
    meta = white
    frag = cyan bold reverse
    old = red
    new = green

[color "grep"]
    context =
    filename =
    function =
    linenumber = white
    match =
    selected =
    separator =

[color "interactive"]
    error =
    header =
    help =
    prompt =

[color "status"]
    added = green
    changed = yellow
    header =
    localBranch =
    nobranch =
    remoteBranch = cyan bold
    unmerged = magenta bold reverse
    untracked = red
    updated = green bold

[alias]
    co = checkout                         # checkoutコマンドのエイリアス
    br = branch                           # branchコマンドのエイリアス
    ci = commit                           # commitコマンドのエイリアス
    st = status                           # statusコマンドのエイリアス
    lg = log --oneline --graph --decorate # 簡潔なログ表示
    lga = log --oneline --graph --decorate --all # 全ブランチのログ表示
    ls = ls-files                         # トラッキングしているファイルを表示
    cp = cherry-pick                      # cherry-pickコマンドのエイリアス
    rb = rebase                           # rebaseコマンドのエイリアス
    rbi = rebase -i                       # インタラクティブなrebaseコマンドのエイリアス
    rbc = rebase --continue               # rebaseの続行コマンドのエイリアス

[diff]
    tool = vimdiff                        # 差分表示ツールにVimdiffを指定

[merge]
    tool = vimdiff                        # マージツールにVimdiffを指定
    conflictstyle = diff3                 # コンフリクト表示スタイルを設定
{{- if $useDelta }}

[interactive]
    diffFilter = delta --color-only      # add -p 等の対話diffもdeltaで表示

[include]
    path = ~/.config/delta/dracula/dracula.gitconfig # Draculaテーマ定義 (.chezmoiexternal.tomlで取得)

[delta]
    features = dracula                    # dracula.gitconfigの [delta "dracula"] を有効化
    side-by-side = true                   # 左右分割表示
{{- end }}

[push]
    default = current                     # プッシュのデフォルト設定

[credential]
{{- if eq .chezmoi.os "darwin" }}
    helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
    helper = manager                      # Git Credential Manager (Git for Windows 標準。cache は unix ソケット前提で動かない)
{{- else }}
    helper = cache --timeout=3600
{{- end }}

[safe]
    directory = ~/.local/share/chezmoi

[includeIf "gitdir:~/.local/share/chezmoi/"]
    path = ~/.gitconfig.github

[includeIf "gitdir:~/Works/src/github.com/"]
    path = ~/.gitconfig.github

{{- if eq .chezmoi.os "darwin" }}
{{- $ageKey := joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt" }}
{{ if (stat $ageKey) }}
[includeIf "gitdir:~/Works/src/gitlab.technoface.co.jp/"]
    path = ~/.gitconfig.technoface.gitlab # Technoface GitLab専用の設定

# hasconfig の glob は wildmatch (pathname) のため先頭 `*` が `/` や `:` を跨げず、
# `*github.com/...` は HTTPS 形式にも scp 形式にもマッチしない。URL 形式ごとに列挙する。
[includeIf "hasconfig:remote.*.url:https://github.com/SakanaAIBusiness/**"]
    path = ~/.gitconfig.sakanaai.github   # SakanaAIBusiness Organization専用の設定
[includeIf "hasconfig:remote.*.url:git@github.com:SakanaAIBusiness/**"]
    path = ~/.gitconfig.sakanaai.github   # SakanaAIBusiness Organization専用の設定
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/SakanaAIBusiness/**"]
    path = ~/.gitconfig.sakanaai.github   # SakanaAIBusiness Organization専用の設定
[includeIf "hasconfig:remote.*.url:https://github.com/SakanaAI/**"]
    path = ~/.gitconfig.sakanaai.github   # SakanaAI Organization専用の設定
[includeIf "hasconfig:remote.*.url:git@github.com:SakanaAI/**"]
    path = ~/.gitconfig.sakanaai.github   # SakanaAI Organization専用の設定
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/SakanaAI/**"]
    path = ~/.gitconfig.sakanaai.github   # SakanaAI Organization専用の設定
{{ end }}
{{- end }}
