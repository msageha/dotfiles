{{/* age は単一共有鍵で全マシン共通 (秘密鍵の配置手順は README) */ -}}
encryption = "age"
[age]
    identity = {{ (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") | quote }}
    recipient = "age100fze4m9k88fyzpg2z5l2hfmk9f299mzl63sjz3s9gk0s8hkt94smeccd0"

[git]
autoCommit = true
autoPush = true

{{ if eq .chezmoi.os "windows" -}}
# chezmoi の既定は pwsh 優先 (無ければ powershell にフォールバック) のため、pwsh の有無で
# .ps1 スクリプトの実行ホストが変わらないよう、標準搭載の Windows PowerShell 5.1 に固定する。
# -NoProfile: プロファイル (starship 初期化等) をスクリプト実行のたびに読ませない。
# -ExecutionPolicy Bypass: 既定が Restricted のマシンでも apply が失敗しないようにする
[interpreters.ps1]
command = "powershell"
args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]

{{ end -}}
[data]
{{- if eq .chezmoi.os "darwin" }}
{{/* 現在の ComputerName を stderr へ表示し、promptStringOnce の入力の参考にする */}}
{{-   $_ := output "sh" "-c" "echo \"current computer_name: $(scutil --get ComputerName 2>/dev/null)\" >&2" }}
{{-   $model := output "sh" "-c" "system_profiler SPHardwareDataType | awk -F': ' '/Model Name/ { print $2 }'" | trim }}
{{-   $prefix := "Mac" }}
{{-   if hasPrefix "MacBook" $model }}{{ $prefix = replace " " "" $model }}{{ end }}
computer_name = {{ promptStringOnce . "computer_name" (printf "e.g.: %s***-<user>" $prefix) | quote }}
{{- end }}

{{ $skipCliTools := false -}}
{{- if ne .chezmoi.os "windows" }}
{{-   $skipCliTools = promptBoolOnce . "skip_cli_tools" "Skip CLI tool installation? (default: yes)" true }}
skip_cli_tools = {{ $skipCliTools }}
{{-   $skipGuiTools := true }}
{{-   if not $skipCliTools }}
{{-     $skipGuiTools = promptBoolOnce . "skip_gui_tools" "Skip GUI tool installation? (default: yes)" true }}
{{-   end }}
skip_gui_tools = {{ $skipGuiTools }}
{{- end }}

{{ $skipWindowsExtras := false -}}
{{- if eq .chezmoi.os "windows" }}
{{-   $skipWindowsExtras = promptBoolOnce . "skip_windows_extras" "Skip coding agent / GUI apps / system settings setup? (default: yes)" true }}
skip_windows_extras = {{ $skipWindowsExtras }}
{{- end }}

{{- if and (not $skipCliTools) (not $skipWindowsExtras) }}
# API キーは fnox が環境変数として注入する (README)。fnox / 1Password 未導入の初回 bootstrap でも
# 通るよう、未注入の変数は空文字で展開する
[data.apiKeys]
anthropic = {{ env "ANTHROPIC_API_KEY" | quote }}
openai = {{ env "OPENAI_API_KEY" | quote }}
gemini = {{ env "GEMINI_API_KEY" | quote }}
googleMaps = {{ env "GOOGLE_MAP_API_KEY" | quote }}
fugu = {{ env "FUGU_API_KEY" | quote }}
fuguCyber = {{ env "FUGU_PAYG_API_KEY" | quote }}
openRouter = {{ env "OPENROUTER_API_KEY" | quote }}
sonatypeGuide = {{ env "SONATYPE_GUIDE_TOKEN" | quote }}
{{- end }}
