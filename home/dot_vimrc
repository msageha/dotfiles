" --------------------------------------------
" Basic Vim Settings
" --------------------------------------------
set nocompatible

set clipboard=unnamed

set wildmenu

" 挿入モードでカーソルキーを使用可能に
" esckeys は nocompatible 時にデフォルトで有効、Vim 9.0+ では削除済みのため設定不要

set backspace=indent,eol,start

set ttyfast

set gdefault

set encoding=utf-8 nobomb

" (+eval が無い vim-tiny 等では if ごと未評価のブロックとしてスキップされ、E319 を出さない)
if has('eval')
  let mapleader=","
endif

set nofixendofline

set autoindent
set smartindent

set pastetoggle=<F2>

set fileencodings=utf-8,iso-2022-jp,sjis,euc-jp

" --------------------------------------------
" Backup and Undo Settings
" --------------------------------------------
" バックアップとundo履歴を集中管理
" silent !mkdir -p ~/.local/state/vim/backups
" set backupdir=~/.local/state/vim/backups
" silent !mkdir -p ~/.local/state/vim/swaps
" set directory=~/.local/state/vim/swaps
" silent !mkdir -p ~/.local/state/vim/undo
" set undodir=~/.local/state/vim/undo
" set viminfo+=n~/.local/state/vim/viminfo

set backupskip=/tmp/*,/private/tmp/*

" --------------------------------------------
" Modeline and Security Settings
" --------------------------------------------
set modeline
set modelines=4

" --------------------------------------------
" Display Settings
" --------------------------------------------
set number

set cursorline

set tabstop=2

set lcs=tab:▸\ ,trail:·,eol:¬,nbsp:_
set list

set hlsearch

set ignorecase
set smartcase

set incsearch

set laststatus=2

set mouse=a

set noerrorbells

set nostartofline

set ruler

" Vim起動時のイントロメッセージを非表示
set shortmess=atI

set showmode

set title

set showcmd

set scrolloff=3

" --------------------------------------------
" Color Scheme
" --------------------------------------------
" (+syntax が無い vim-tiny 等では if ごと未評価のブロックとしてスキップされ、E319 を出さない)
if has('syntax')
  silent! packadd! dracula
  syntax enable
  silent! colorscheme dracula
endif
