" --------------------------------------------
" Basic Vim Settings
" --------------------------------------------
" vim -u ~/.vimrc で読ませたときは -N が無いと compatible のままになるため明示する
set nocompatible
set clipboard=unnamed
set wildmenu
set backspace=indent,eol,start
set gdefault
set encoding=utf-8 nobomb

" +eval が無い vim-tiny 等では if ごと未評価のブロックとしてスキップされ、E319 を出さない
if has('eval')
  let mapleader=","
endif

set nofixendofline
set autoindent
set smartindent
set pastetoggle=<F2>
set fileencodings=utf-8,iso-2022-jp,sjis,euc-jp

" --------------------------------------------
" State and Backup Settings
" --------------------------------------------
" viminfo の保存先ディレクトリは Vim が作らないため先に作成する
silent !mkdir -p ~/.local/state/vim
set viminfo+=n~/.local/state/vim/viminfo
set backupskip=/tmp/*,/private/tmp/*

" --------------------------------------------
" Modeline and Security Settings
" --------------------------------------------
set modeline
set modelines=4

" --------------------------------------------
" Display Settings
" --------------------------------------------
set number
set cursorline
set tabstop=2
set lcs=tab:▸\ ,trail:·,eol:¬,nbsp:_
set list
set hlsearch
set ignorecase
set smartcase
set incsearch
set laststatus=2
set mouse=a
set noerrorbells
set nostartofline
set ruler
set shortmess=atI
set showmode
set title
set showcmd
set scrolloff=3

" --------------------------------------------
" Color Scheme
" --------------------------------------------
" +syntax が無い vim-tiny 等では if ごと未評価のブロックとしてスキップされ、E319 を出さない
if has('syntax')
  " packadd はこの packpath を見てプラグインを探すため、~/.vim ではなく
  " ~/.local/share/vim (chezmoiexternal の展開先) を追加しておく
  set packpath^=~/.local/share/vim
  silent! packadd! dracula
  syntax enable
  silent! colorscheme dracula
endif
