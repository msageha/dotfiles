{{ if and (eq .chezmoi.os "darwin") (not (dig "skip_cli_tools" false .)) -}}
#!/bin/bash
set -euo pipefail

{{ include "../install/lib.sh" }}
activate_tool_paths

# mole (mo) の最適化は対話を伴いうるため CI ではスキップする
if [ -z "${CI:-}" ]; then
    mo optimize
    mo clean
fi

{{ if not (dig "skip_gui_tools" false .) -}}
# GUI アプリの設定のため CI ではスキップする。
# プロファイルに埋め込むフォントは external が配置するので、before ではなく after で実行する
if [ -z "${CI:-}" ]; then
{{   include "../install/macos/dracula_theme.sh" }}
fi
{{ end -}}
{{ end -}}
