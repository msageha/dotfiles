{{- /* 条件は .chezmoiexternal.toml の nanobanana external と同じ式にそろえる (build に要る node が入る条件) */}}
{{- if and (ne .chezmoi.os "windows") (not (dig "skip_cli_tools" true .)) -}}
#!/bin/bash
set -euo pipefail

{{ include "../install/lib.sh" }}
activate_tool_paths

# nanobanana MCP server {{ .mcp.nanobanana }} を build する。版を埋め込んでいるので、.chezmoidata.toml の pin を更新すると再実行される
cd "$HOME/.local/share/nanobanana-mcp/mcp-server"
npm ci
# upstream の package-lock.json は既知の脆弱性を含んだままリリースされているため、semver 範囲内 (--force なし) で更新する。
# npm のレジストリに使う Takumi Guard (npm.flatt.tech) の audit endpoint は 502 を返すことがあるため、3 回まで試す
npm audit fix || npm audit fix || npm audit fix
npm run build
{{ end -}}
