{{- /* gate は .chezmoiexternal.toml の nanobanana external と同じ (build に必要な node の導入条件) */}}
{{- if and (ne .chezmoi.os "windows") (not (dig "skip_cli_tools" true .)) -}}
#!/bin/bash
set -euo pipefail

{{ include "../install/lib.sh" }}
activate_tool_paths

# nanobanana MCP server {{ .mcp.nanobanana }} の build。pin (.chezmoidata.toml) の更新でこの内容が変わり、再実行される
cd "$HOME/.local/share/nanobanana-mcp/mcp-server"
npm ci
# upstream の package-lock.json が既知の脆弱性を含んだままリリースされているため、
# semver 範囲内 (--force なし) でローカルに追従させる
npm audit fix
npm run build
{{ end -}}
