{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -e
export CHEZMOI_SOURCE_DIR={{ .chezmoi.sourceDir | replace "'" "'\\''" | squote }}
{{   include "../install/macos/xcode_select.sh" }}

export SKIP_CLI_TOOLS={{ dig "skip_cli_tools" false . }}
export SKIP_GUI_TOOLS={{ dig "skip_gui_tools" false . }}
{{   include "../install/macos/brew.sh" }}
{{   if not (dig "skip_cli_tools" false .) -}}
{{     include "../install/common/claude_plugins.sh" }}
{{   end -}}

# GUI アプリ設定・システム設定・softwareupdate は GUI/対話を伴うため CI ではスキップする
if [ -z "${CI:-}" ]; then
{{- /* computer_name は darwin の init では必ず promptStringOnce で設定されるが、
       手動編集や他 OS から流用した config でキーが無くても template error で
       apply 全体を落とさないよう dig でフォールバックする (空なら consumer 側で skip) */}}
export COMPUTER_NAME={{ dig "computer_name" "" . | replace "'" "'\\''" | squote }}
{{   include "../install/macos/system_settings.sh" }}
{{   if not (dig "skip_gui_tools" false .) -}}
{{   include "../install/macos/app_settings.sh" }}
{{   include "../install/macos/dracula_theme.sh" }}
  if softwareupdate --list 2>&1 | grep -qE '^[[:space:]]*\* (Label|Title):'; then
    echo "Software Update が見つかりました。インストールします..."
    softwareupdate --install --all
  else
    echo "利用可能な Software Update はありません。スキップします。"
  fi
{{   end -}}
fi
{{ end -}}
