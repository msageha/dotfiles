{{ if ne .chezmoi.os "windows" -}}
#!/bin/bash
set -e

{{ if eq .chezmoi.os "linux" -}}
# mise (と debian 系では claude 等) が ~/.local/bin に入るため、Alpine 含む linux 全般で
# 後続 include が参照できるよう PATH を通す (ログインシェルに無い初回マシン対策)
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew の prefix は Apple Silicon (/opt/homebrew) と Intel (/usr/local) で異なる
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{ end -}}

export CHEZMOI_SOURCE_DIR={{ .chezmoi.sourceDir | replace "'" "'\\''" | squote }}

# 各 install スクリプトは色変数や main などの名前が重複するため subshell で隔離する。
# ファイル間で必要な環境変数 (mise の PATH) は親で明示的に引き継ぐ。
(
{{   include "../install/common/setup_shell.sh" }}
)
(
{{   include "../install/common/fisher.sh" }}
)
(
{{   include "../install/common/mise.sh" }}
)
eval "$(mise activate bash --shims)"
(
{{   include "../install/common/completions.sh" }}
)

{{ if not (dig "skip_cli_tools" false .) -}}
(
{{   include "../install/common/git_open.sh" }}
)
(
{{   include "../install/common/git_secrets.sh" }}
)
{{ end -}}

{{ if not (dig "skip_gui_tools" false .) -}}
# フォントの描画はクライアント側 (端末エミュレータ) で行われるため、ヘッドレス環境では不要。
# GUI レス (skip_gui_tools=true) ならスキップする。
# サーバー上で画像/PDF 等のラスタライズをする場合は別途明示的に入れる必要あり。
(
{{   include "../install/common/fonts.sh" }}
)
(
{{   include "../install/common/ghostty.sh" }}
)
{{ end -}}

# fish の設定ファイルのキャッシュを削除する
rm -f "$HOME/.cache/fish/config.fish"
{{ end -}}
