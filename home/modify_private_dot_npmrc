{{- /* chezmoi:modify-template */ -}}
{{- /*
  ~/.npmrc (npm / pnpm / yarn v1 が読む) の registry と npm.flatt.tech の _authToken の行だけを差し替え、
  strict-ssl 等のマシンローカルな行は空行も含めて温存する。
*/ -}}
{{- $token := dig "apiKeys" "takumiGuard" "" . -}}
{{- $lines := list -}}
{{- $stdin := trimSuffix "\n" (dig "stdin" "" .chezmoi) -}}
{{- if $stdin -}}
{{-   range splitList "\n" $stdin -}}
{{-     if not (regexMatch `^\s*(registry\s*=|//npm\.flatt\.tech/:_authToken\s*=)` .) -}}
{{-       $lines = append $lines . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $lines = append $lines "registry=https://npm.flatt.tech/" -}}
{{- if $token -}}
{{-   $lines = append $lines (printf "//npm.flatt.tech/:_authToken=%s" $token) -}}
{{- end -}}
{{ join "\n" $lines }}
