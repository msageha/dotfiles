{
  "model": {
    "name": "gemini-3.1-pro-preview"
  },
  "tools": {
    "sandbox": false
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    }
  },
  "general": {
    "vimMode": true,
    "previewFeatures": true,
{{- /* settings で選べるのは default / auto_edit / plan だけで、yolo は CLI フラグ (--approval-mode=yolo) 専用。
       auto_edit (edit 系のツールを自動承認) が settings で置ける最も緩い値 */}}
    "defaultApprovalMode": "auto_edit"
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@{{ .mcp.context7 }}"],
      "trust": true
    },
    "maps-grounding-lite": {
      "httpUrl": "https://mapstools.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{{ dig "apiKeys" "googleMaps" "" . }}"
      },
      "trust": true
    }
  }
}
