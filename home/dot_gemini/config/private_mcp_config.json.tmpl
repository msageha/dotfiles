{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@{{ .mcp.context7 }}"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@{{ .mcp.chromeDevtools }}"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@{{ .mcp.playwright }}"]
    },
    "maps-grounding-lite": {
      "httpUrl": "https://mapstools.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{{ dig "apiKeys" "googleMaps" "" . }}"
      }
    }{{ if eq .chezmoi.os "darwin" }},
    {{- /* dart (flutter 同梱) は mise が darwin + skip_cli_tools=false でのみ導入する。
           lookPath は apply 時の PATH に依存して非決定的なため OS 条件で固定する
           (codex / grok / claude と同じ裁定) */}}
    "dart": {
      "command": "dart",
      "args": ["mcp-server"]
    },
    "xcode": {
      "command": "xcrun",
      "args": ["mcpbridge"]
    }{{ end }}
  }
}
