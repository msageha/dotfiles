{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@{{ .mcp.context7 }}"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@{{ .mcp.chromeDevtools }}"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@{{ .mcp.playwright }}"]
    },
    "maps-grounding-lite": {
      "httpUrl": "https://mapstools.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{{ dig "apiKeys" "googleMaps" "" . }}"
      }
    }{{ if eq .chezmoi.os "darwin" }},
    {{- /* dart / xcode MCP は macOS 専用バイナリ (dart, xcrun) に依存する */}}
    "dart": {
      "command": "dart",
      "args": ["mcp-server"]
    },
    "xcode": {
      "command": "xcrun",
      "args": ["mcpbridge"]
    }{{ end }}
  }
}
