# 環境変数・PATH とツールのシェル統合は bash (~/.bash_profile) と共有する。
# zsh 自身の HISTFILE は macOS の /etc/zshrc による上書きを避けるため
# ~/.zshrc (install/common/setup_shell.sh が管理するブロック) で設定する
source "$HOME/.config/shell/env.sh"

# --- 補完システム ---
# completions.sh が生成した _<cmd> 形式の補完を compinit より前に fpath へ追加する。
# brew shellenv も site-functions を fpath へ足すため env.sh の後、zoxide 等の compdef より前に初期化する。
# zcompdump はキャッシュのため ~/.cache/zsh へ置く (ディレクトリは setup_directory.sh が作成する)。
# bashcompinit は aws_completer の complete -C (bash 形式) 用
fpath=("$HOME/.config/zsh/completions" $fpath)
autoload -Uz compinit && compinit -d "$HOME/.cache/zsh/zcompdump"
autoload -Uz bashcompinit && bashcompinit

source "$HOME/.config/shell/integrations.sh"
