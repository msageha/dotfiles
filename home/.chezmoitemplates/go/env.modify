{{- /*
  go コマンドの設定ファイル (`go env GOENV`。`go env -w` の書き込み先) のうち GOPATH / GOBIN / GOMODCACHE / GOPROXY の行だけを
  差し替え、`go env -w` で足した行 (GOPRIVATE 等) は温存する。shell の環境変数と違い、shell を経ずに起動した go (GUI の IDE 等) も読む。
  環境変数で設定した値はこのファイルより優先される。
  - GOBIN: PATH に入っている ~/.local/bin。mise が有効な環境では mise が環境変数で自身の管理ディレクトリへ上書きする
  - GOMODCACHE: module のキャッシュは消しても再取得できるので、GOPATH ではなく XDG のキャッシュの下に置く
  - GOPROXY: Takumi Guard (悪性パッケージを遮断する proxy)。`,direct` を付けると未収載・ブロック済みの module で
    proxy を迂回できてしまうため URL だけを指定する。認証 token は ~/.netrc (modify_private_dot_netrc)
*/ -}}
{{- $home := .chezmoi.homeDir -}}
{{- $lines := list
      (printf "GOPATH=%s/Works" $home)
      (printf "GOBIN=%s/.local/bin" $home)
      (printf "GOMODCACHE=%s/.cache/go/mod" $home)
      "GOPROXY=https://golang.flatt.tech" -}}
{{- $stdin := trimSuffix "\n" (dig "stdin" "" .chezmoi) -}}
{{- if $stdin -}}
{{-   range splitList "\n" $stdin -}}
{{-     if not (regexMatch `^(GOPATH|GOBIN|GOMODCACHE|GOPROXY)=` .) -}}
{{-       $lines = append $lines . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ join "\n" $lines }}
