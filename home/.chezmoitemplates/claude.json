{
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "deepLinkTerminal": "Ghostty",
  "showExpandedTodos": true,
  "showSpinnerTree": true,
  "hasSeenTasksHint": true,
  "hasOpenedAgentsView": true,
  "officialMarketplaceAutoInstallAttempted": false,
  "officialMarketplaceAutoInstalled": false,
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@{{ .mcp.context7 }}"
      ],
      "env": {}
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@{{ .mcp.chromeDevtools }}"
      ],
      "env": {}
    },
    "antigravity": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@ask-llm/antigravity-mcp@0.7.2"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@{{ .mcp.playwright }}"
      ],
      "env": {}
    },
{{- /* dart (flutter 同梱) は macOS + skip_cli_tools=false でのみ導入する。 */}}
{{- if eq .chezmoi.os "darwin" }}
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "env": {}
    },
{{- end }}
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "drawio": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp@1.5.0"
      ]
    },
{{- if eq .chezmoi.os "darwin" }}
    "xcode": {
      "type": "stdio",
      "command": "xcrun",
      "args": [
        "mcpbridge"
      ],
      "env": {}
    },
{{- end }}
    "maps-grounding-lite": {
      "type": "http",
      "url": "https://mapstools.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{{ dig "apiKeys" "googleMaps" "" . }}"
      }
    },
{{- /* nanobanana-mcp-server 0.4.5 は fastmcp>=2.11.0 と上限なしで宣言しており、fastmcp 4 で削除された fastmcp.tools.tool に依存して起動に失敗するため <3 に制約する。 */}}
    "nano-banana": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "fastmcp<3",
        "nanobanana-mcp-server@0.4.5"
      ],
      "env": {
        "GEMINI_API_KEY": "{{ dig "apiKeys" "gemini" "" . }}"
      }
    }
  }
}
