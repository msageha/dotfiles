{
  "hasCompletedOnboarding": true,
  "theme": "dark",
  "deepLinkTerminal": "Ghostty",
  "showExpandedTodos": true,
  "showSpinnerTree": true,
  "hasSeenTasksHint": true,
  "hasOpenedAgentsView": true,
  "officialMarketplaceAutoInstallAttempted": false,
  "officialMarketplaceAutoInstalled": false,
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@{{ .mcp.context7 }}"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@{{ .mcp.chromeDevtools }}"
      ]
    },
    "antigravity": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@ask-llm/antigravity-mcp@{{ .mcp.antigravity }}"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@{{ .mcp.playwright }}"
      ]
    },
{{- /* xcrun は macOS 専用で、dart も flutter とともに macOS にだけ導入する (mise config) */}}
{{- if eq .chezmoi.os "darwin" }}
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "xcode": {
      "type": "stdio",
      "command": "xcrun",
      "args": [
        "mcpbridge"
      ]
    },
{{- end }}
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "drawio": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp@{{ .mcp.drawio }}"
      ]
    },
{{- if and (ne .chezmoi.os "windows") (not (dig "skip_cli_tools" true .)) }}
{{- /* .chezmoiexternal.toml が展開し run_onchange_after_95_nanobanana-mcp.sh.tmpl が build した MCP server を起動する。
      条件は build に要る node の導入条件 (mise config の node と同じ式)。GEMINI_API_KEY は server が NANOBANANA_API_KEY の無いときに読む */}}
    "nano-banana": {
      "type": "stdio",
      "command": "node",
      "args": [
        "{{ .chezmoi.homeDir }}/.local/share/nanobanana-mcp/mcp-server/dist/index.js"
      ],
      "env": {
        "GEMINI_API_KEY": "{{ dig "apiKeys" "gemini" "" . }}"
      }
    },
{{- end }}
    "maps-grounding-lite": {
      "type": "http",
      "url": "https://mapstools.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{{ dig "apiKeys" "googleMaps" "" . }}"
      }
    }
  }
}
