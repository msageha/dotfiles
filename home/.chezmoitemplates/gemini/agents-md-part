{{- /* 共通 AGENTS.md を「## git」見出しの前 (part "0") と以降 (part "1"。末尾に suffix を連結) に分けて返す。
      Antigravity は rule ファイル 1 つを 24,000 bytes (include 展開後) で切り詰めるため、
      ~/.gemini/config/AGENTS.md と ~/.gemini/config/GEMINI.md (どちらも frontmatter 無しの常時有効な global rule) に分けて配り、
      上限を超える描画は fail で止める */ -}}
{{- /* Windows の checkout は CRLF になるので、分割と連結の前に改行を LF にそろえる */ -}}
{{- $parts := splitn "\n## git\n" 2 (replace "\r\n" "\n" (include "dot_config/agents/AGENTS.md")) -}}
{{- if ne (len $parts) 2 -}}
{{-   fail "dot_config/agents/AGENTS.md: no \"## git\" heading to split the Antigravity rule files at" -}}
{{- end -}}
{{- /* rule 全体が token の予算を超えると、大きいファイルから path だけの pointer に格下げされるので、もう一方を読みに行けるよう、
       前半の末尾に後半の所在を、後半の見出しに前半の所在を書く (後半は前半の前文を参照する) */ -}}
{{- $body := printf "%s\n「git」節以降と Antigravity 固有の補足は `~/.gemini/config/GEMINI.md` にある。本文が読み込まれていなければ、着手前に読む。\n" $parts._0 -}}
{{- if eq .part "1" -}}
{{-   $body = printf "# AGENTS.md — 作業規約 (続き: git 節以降。前文と前半は `~/.gemini/config/AGENTS.md`。読み込まれていなければ着手前に読む)\n\n## git\n%s\n%s" $parts._1 (replace "\r\n" "\n" .suffix) -}}
{{- end -}}
{{- if gt (len $body) 24000 -}}
{{-   fail (printf "%s would be %d bytes; Antigravity truncates rule files at 24000 bytes" .target (len $body)) -}}
{{- end -}}
{{- /* この repo で作業するときは repo 直下の AGENTS.md も always_on の rule になるので、後半の描画で一緒に検査する。
       global と always_on の rule は合わせて 20,000 tokens の予算を共有し、超えると大きいファイルから pointer に格下げされる。
       token の数え方は公式 docs に無いので、日本語 1 文字 (3 bytes) を 1 token と置いて 3 ファイルの合計 bytes で見る */ -}}
{{- if eq .part "1" -}}
{{-   $repo := replace "\r\n" "\n" (include "../AGENTS.md") -}}
{{-   if gt (len $repo) 24000 -}}
{{-     fail (printf "AGENTS.md at the repository root is %d bytes; Antigravity truncates rule files at 24000 bytes" (len $repo)) -}}
{{-   end -}}
{{-   $first := includeTemplate "gemini/agents-md-part" (dict "part" "0" "target" "~/.gemini/config/AGENTS.md") -}}
{{-   $total := add (len $first) (len $body) (len $repo) -}}
{{-   if gt $total 60000 -}}
{{-     fail (printf "Antigravity rule files would total %d bytes (about %d tokens); the global and always_on rules share a 20000-token budget" $total (div $total 3)) -}}
{{-   end -}}
{{- end -}}
{{- $body -}}
