{{- /* 1Password の SSH Key item から鍵 1 つを取得する。dict の vault / item / field
       (field は "private_key?ssh-format=openssh" か "public_key") を受ける。
       field はラベルではなく id で指定する (ラベルは UI 言語で変わり、日本語 UI では秘密鍵が "秘密鍵" になる)。
       op read が exit 0 で空を返すと chezmoi は描画結果が空の target を削除するため、空なら fail で apply を止める */ -}}
{{- $key := onepasswordRead (printf "op://%s/%s/%s" .vault .item .field) -}}
{{- if not $key }}{{ fail (printf "1Password returned an empty %q for item %q" .field .item) }}{{ end -}}
{{ $key }}
