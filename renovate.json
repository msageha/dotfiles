{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "separateMajorMinor": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "7 days",
  "customDatasources": {
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://app-updates.agilebits.com/product_history/CLI2",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "PR の乱立を防ぐため、major 以外 (minor/patch/pin/digest) の更新は manager・エコシステム横断で 1 つの PR に集約する。major は separateMajorMinor により分離され、グルーピングせず個別 PR で人手レビューする",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "patch/minor は minimumReleaseAge (7日) 経過後、CI green を条件に自動マージする。major は供給網攻撃対策の猶予期間だけでは不十分なため対象外とし、人手レビューを必須とする",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "gcloud は calver 的にほぼ毎週 major が上がるため、major 更新も non-major と同じグループ PR + automerge で扱う",
      "matchDepNames": [
        "google/cloud-sdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchDatasources": [
        "custom.onepassword-cli"
      ],
      "extractVersion": "op_[^/]+_v(?<version>\\d+\\.\\d+\\.\\d+)\\.zip$",
      "versioning": "semver"
    },
    {
      "description": "op は GitHub に公開リポジトリが存在せず組み込み mise manager では lookup 不能 (no-result 警告の抑止)。更新は custom.onepassword-cli datasource の regex manager が担う",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "op"
      ],
      "enabled": false
    },
    {
      "description": "age / fnox は custom regex manager 側で更新するため、組み込み mise manager との二重検出 (重複 PR) を防いで片側に寄せる",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "age",
        "fnox"
      ],
      "enabled": false
    },
    {
      "description": "flarectl (cmd/flarectl) は cloudflare-go の v0 系にのみ存在し、v0.117.0 が最後。v2 以降は Stainless 生成 SDK へ全面置換されて cmd/ ごと削除され、module path も /vN 付きに変わったため、go backend では v1.0.0 以上を install できない (unknown revision で失敗する)。リポジトリのタグを追う github-tags datasource では検知できないので、バージョン範囲で成立しない更新を除外する",
      "matchDepNames": [
        "cloudflare/cloudflare-go"
      ],
      "allowedVersions": "<1.0.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "chezmoi workflow (sh / ps1) と Dockerfile のインストーラ tag を mise.toml の chezmoi pin と同じグループ PR で追従させる",
      "managerFilePatterns": [
        "/^\\.github/workflows/chezmoi\\.yaml$/",
        "/^docker/Dockerfile\\.debian$/",
        "/^docker/Dockerfile\\.alpine$/"
      ],
      "matchStrings": [
        "get\\.chezmoi\\.io\\)\" -- -b \"\\$HOME/\\.local/bin\" -t v(?<currentValue>[\\d.]+)",
        "get\\.chezmoi\\.io/ps1'\\)} -b '\\$chezmoiBin' -t 'v(?<currentValue>[\\d.]+)'"
      ],
      "depNameTemplate": "twpayne/chezmoi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)"
    },
    {
      "customType": "regex",
      "description": "コーディングエージェント設定内の MCP サーバー (npx -y <pkg>@<version>) を npm datasource で更新する。context7 / chrome-devtools / playwright の pin は home/.chezmoidata.toml へ一元化済みで、ここは claude.json に残る個別 pin (antigravity / drawio 等) と、誤って再インライン化された pin の追従用",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/claude\\.json$/",
        "/^home/dot_gemini/private_settings\\.json\\.tmpl$/",
        "/^home/dot_gemini/config/private_mcp_config\\.json\\.tmpl$/",
        "/^home/dot_codex/modify_private_config\\.toml$/",
        "/^home/dot_grok/modify_private_config\\.toml$/"
      ],
      "matchStrings": [
        "\"-y\",\\s*\"(?<depName>(?:@[a-z0-9._-]+/)?[a-z0-9._-]+)@(?<currentValue>\\d[\\w.-]*)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "home/.chezmoidata.toml の MCP バージョン pin (単一ソース) を annotation コメントで追従する",
      "managerFilePatterns": [
        "/^home/\\.chezmoidata\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n[A-Za-z0-9_]+ = \"(?<currentValue>[\\w.-]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "uvx で起動する MCP サーバーを pypi datasource で更新する",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/claude\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>nanobanana-mcp-server|mcp-youtube-transcript)@(?<currentValue>[\\w.-]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "workflow の container.image (digest pin + バージョンコメント) を docker datasource で更新する。ネイティブのgithub-actions managerはdigestのみ追従し、末尾のバージョンコメントを更新しないため必要",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[a-z0-9./_-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\s+#\\s+(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "dprint.json の公式プラグイン (dprint/dprint-plugin-*) の WASM URL を更新する。@ 以降の sha256 checksum は github-release-attachments datasource が release asset (plugin.wasm) の実ハッシュ照合で追従させる",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "dprint.json の g-plane プラグインの WASM URL を更新する (tag は v prefix 付きなので currentValue に含めて照合する)",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/g-plane/(?<depName>[a-z0-9_-]+)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "g-plane/{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Docker ビルドのベースイメージを docker datasource で追従する (docker-image-cd / docker-debian の base: / mise.toml の docker-build 引数 / cloudbuild.yaml の BASE_IMAGE と _GPU_BASE_IMAGE)",
      "managerFilePatterns": [
        "/^\\.github/workflows/docker-image-cd\\.yaml$/",
        "/^\\.github/workflows/docker-debian\\.yaml$/",
        "/^mise\\.toml$/",
        "/^cloudbuild\\.yaml$/"
      ],
      "matchStrings": [
        "base: (?<depName>[^:]+):(?<currentValue>[^\\s]+)\\n",
        "mise run docker-build(?:-multi)? [\\w-]+ (?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)",
        "--build-arg=BASE_IMAGE=(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)\\n",
        "_GPU_BASE_IMAGE: \"(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "op = \"(?<currentValue>[^\"]+)\"\\n"
      ],
      "depNameTemplate": "1password-cli",
      "datasourceTemplate": "custom.onepassword-cli"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の Nerd Fonts release zip (SourceCodePro / NerdFontsSymbolsOnly) を github-releases で追従させる。2 URL が同一バージョンで一括更新される",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "nerd-fonts/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^install/windows/setup_powershell\\.ps1$/"
      ],
      "matchStrings": [
        "\\$NerdFontsVersion = '(?<currentValue>v[\\d.]+)'\\n"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/dot_config/mise/config\\.toml\\.tmpl$/"
