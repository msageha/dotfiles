{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "7 days",
  "customDatasources": {
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://app-updates.agilebits.com/product_history/CLI2",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "PR の乱立を防ぐため、major 以外 (minor/patch/pin/digest) の更新は manager・エコシステム横断で 1 つの PR に集約する。major は separateMajorMinor により分離され、グルーピングせず個別 PR で人手レビューする",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "patch/minor は minimumReleaseAge (7日) 経過後、CI green を条件に自動マージする。major は供給網攻撃対策の猶予期間だけでは不十分なため対象外とし、人手レビューを必須とする",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "gcloud は calver 的にほぼ毎週 major が上がるため、major 更新も non-major と同じグループ PR + automerge で扱う",
      "matchDepNames": [
        "google/cloud-sdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "matchDatasources": [
        "custom.onepassword-cli"
      ],
      "extractVersion": "op_[^/]+_v(?<version>\\d+\\.\\d+\\.\\d+)\\.zip$",
      "versioning": "semver"
    },
    {
      "description": "op / age / fnox は mise.toml の annotation (regex manager) 側で更新するため、組み込み mise manager との二重検出 (重複 PR) を防いで片側に寄せる。op は GitHub に公開リポジトリが無く組み込み manager では lookup 不能 (no-result 警告) でもある",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "op",
        "age",
        "fnox"
      ],
      "enabled": false
    },
    {
      "description": "flarectl (cmd/flarectl) は cloudflare-go の v0 系にのみ存在し、v0.117.0 が最後。v2 以降は Stainless 生成 SDK へ全面置換されて cmd/ ごと削除され、module path も /vN 付きに変わったため、go backend では v1.0.0 以上を install できない (unknown revision で失敗する)。リポジトリのタグを追う github-tags datasource では検知できないので、バージョン範囲で成立しない更新を除外する",
      "matchDepNames": [
        "cloudflare/cloudflare-go"
      ],
      "allowedVersions": "<1.0.0"
    },
    {
      "description": "typescript-language-server は JS 版 tsserver 前提のため、typescript は 5 系に留める (mise config.toml.tmpl の pin コメントと同じ理由)",
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "typescript"
      ],
      "allowedVersions": "<6"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "chezmoi workflow (sh / ps1) と docker/provision.sh のインストーラ tag を mise.toml の chezmoi pin と同じグループ PR で追従させる",
      "managerFilePatterns": [
        "/^\\.github/workflows/chezmoi\\.yaml$/",
        "/^docker/provision\\.sh$/"
      ],
      "matchStrings": [
        "get\\.chezmoi\\.io\\)\" -- -b \"\\$HOME/\\.local/bin\" -t v(?<currentValue>[\\d.]+)",
        "get\\.chezmoi\\.io/ps1'\\)} -b '\\$chezmoiBin' -t 'v(?<currentValue>[\\d.]+)'"
      ],
      "depNameTemplate": "twpayne/chezmoi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)"
    },
    {
      "customType": "regex",
      "description": "annotation コメント (# renovate: datasource= depName= [packageName=] [versioning=] [extractVersion=]) 直下の `key = \"version\"` 行を追従する。対象は home/.chezmoidata.toml の MCP pin (単一ソース) と mise.toml / mise config.toml.tmpl のツール pin。versioning / extractVersion は annotation に書いたときだけ効き、無ければ Renovate 既定のまま。java は java-version datasource が temurin- prefix なしの版を返すため prefix を currentValue の外に置く",
      "managerFilePatterns": [
        "/^home/\\.chezmoidata\\.toml$/",
        "/^mise\\.toml$/",
        "/^home/dot_config/mise/config\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z.-]+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n\"?[A-Za-z0-9_.:/@-]+\"? = \"(?:temurin-)?(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "workflow の container.image (digest pin + バージョンコメント) を docker datasource で更新する。ネイティブのgithub-actions managerはdigestのみ追従し、末尾のバージョンコメントを更新しないため必要",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[a-z0-9./_-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\s+#\\s+(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "dprint.json の公式プラグイン (dprint/dprint-plugin-*) の WASM URL を更新する。@ 以降の sha256 checksum は github-release-attachments datasource が release asset (plugin.wasm) の実ハッシュ照合で追従させる",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "dprint.json の g-plane プラグインの WASM URL を更新する (tag は v prefix 付きなので currentValue に含めて照合する)",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/g-plane/(?<depName>[a-z0-9_-]+)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "g-plane/{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Docker ビルドのベースイメージを docker datasource で追従する (docker-image-cd / docker workflow の base: / docker/build.sh の variant 表 / Dockerfile の ARG BASE_IMAGE 既定値)",
      "managerFilePatterns": [
        "/^\\.github/workflows/docker-image-cd\\.yaml$/",
        "/^\\.github/workflows/docker\\.yaml$/",
        "/^docker/build\\.sh$/",
        "/^docker/Dockerfile\\.debian$/",
        "/^docker/Dockerfile\\.alpine$/"
      ],
      "matchStrings": [
        "base: (?<depName>[^:]+):(?<currentValue>[^\\s]+)\\n",
        "base_image=(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)",
        "ARG BASE_IMAGE=(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)\\n"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の Nerd Fonts release zip (SourceCodePro / NerdFontsSymbolsOnly) を github-releases で追従させる。2 URL が同一バージョンで一括更新される",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "nerd-fonts/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^install/windows/setup_powershell\\.ps1$/"
      ],
      "matchStrings": [
        "\\$NerdFontsVersion = '(?<currentValue>v[\\d.]+)'\\n"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "pre-commit hook の rev (autoupdate --freeze 形式の SHA pin + frozen コメント) を github-tags で更新する。組み込みの pre-commit manager は frozen 形式に未対応 (renovate#22567) のため必要",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "repo: https://github\\.com/(?<depName>[^\\s]+)\\n\\s+rev: (?<currentDigest>[a-f0-9]{40}) # frozen: (?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (archive pin) の dracula/vim commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/vim/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/vim",
      "packageNameTemplate": "https://github.com/dracula/vim",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (archive pin) の dracula/delta commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/delta/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/delta",
      "packageNameTemplate": "https://github.com/dracula/delta",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (archive pin) の dracula/tmux commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/tmux/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/tmux",
      "packageNameTemplate": "https://github.com/dracula/tmux",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (archive pin) の dracula/dircolors commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/dircolors/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/dircolors",
      "packageNameTemplate": "https://github.com/dracula/dircolors",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (file pin) の git-open commit SHA を git-refs datasource で master の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/paulirish/git-open/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "paulirish/git-open",
      "packageNameTemplate": "https://github.com/paulirish/git-open",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (file pin) の dracula/ghostty commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dracula/ghostty/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "dracula/ghostty",
      "packageNameTemplate": "https://github.com/dracula/ghostty",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (file pin) の dracula/xcode commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dracula/xcode/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "dracula/xcode",
      "packageNameTemplate": "https://github.com/dracula/xcode",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external (archive pin) の powerline/fonts commit SHA を git-refs datasource で default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/powerline/fonts/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "powerline/fonts",
      "packageNameTemplate": "https://github.com/powerline/fonts",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の source-han-code-jp をタグ追従させる。R 付きタグのみがフォント成果物のリリースで無印はソースのリリースのため、extractVersion で R 付きに限定する (semver ではないので loose versioning)",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "source-han-code-jp/archive/refs/tags/(?<currentValue>[\\d.]+R)\\.zip"
      ],
      "depNameTemplate": "adobe-fonts/source-han-code-jp",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>[\\d.]+R)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "setup-mise composite action が mise-action に渡す mise 本体バージョン pin (\"latest\" 解決だと上流の release 作成直後の asset 未アップロード等で 404 になりうるため固定) を github-releases で追従させる",
      "managerFilePatterns": [
        "/^\\.github/actions/setup-mise/action\\.yml$/"
      ],
      "matchStrings": [
        "default: \"(?<currentValue>[\\d.]+)\"\\n"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)"
    },
    {
      "customType": "regex",
      "description": "壁紙 URL の dracula/wallpaper commit SHA を git-refs datasource で master の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^install/macos/system_settings\\.sh$/",
        "/^install/ubuntu/system_settings\\.sh$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dracula/wallpaper/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "dracula/wallpaper",
      "packageNameTemplate": "https://github.com/dracula/wallpaper",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    }
  ]
}
