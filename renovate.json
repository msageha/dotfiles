    {
      "customType": "regex",
      "description": "gcloud は GitHub にバージョンタグを持たないため、SDK バージョンと同一タグが付く Docker Hub の google/cloud-sdk イメージで追従する",
      "managerFilePatterns": [
        "/^home/dot_config/mise/config\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
