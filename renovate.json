{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "7 days",
  "customDatasources": {
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://app-updates.agilebits.com/product_history/CLI2",
      "format": "html"
    }
  },
  "gitIgnoredAuthors": ["github-actions[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "major 以外の更新を 1 つの PR にまとめる。major は個別の PR で人手レビューする",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "patch / minor は minimumReleaseAge の経過後、CI green なら自動マージする。major は猶予期間だけでは supply chain 攻撃に備えきれないので人手レビューにする",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "gcloud はほぼ毎週 major が上がるので、major も non-major と同じグループ PR で自動マージする",
      "matchDepNames": [
        "google/cloud-sdk"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "matchDatasources": [
        "custom.onepassword-cli"
      ],
      "extractVersion": "op_[^/]+_v(?<version>\\d+\\.\\d+\\.\\d+)\\.zip$",
      "versioning": "semver"
    },
    {
      "description": "op / age / fnox は mise.toml の `# renovate:` 注釈 (regex manager) で更新するので、組み込みの mise manager では無効にして重複 PR を防ぐ (op は公開 GitHub リポジトリが無く、組み込み manager では lookup できない)",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "op",
        "age",
        "fnox"
      ],
      "enabled": false
    },
    {
      "description": "flarectl は cloudflare-go の v0 系にしか無く、v1.0.0 以上は go backend で install できない。github-tags datasource ではこれを検知できないので v1 未満に限る",
      "matchDepNames": [
        "cloudflare/cloudflare-go"
      ],
      "allowedVersions": "<1.0.0"
    },
    {
      "description": "typescript-language-server は JS 版の tsserver を前提とするので、typescript は 5 系に留める",
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "typescript"
      ],
      "allowedVersions": "<6"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "chezmoi workflow (sh / ps1) と両 Dockerfile の chezmoi インストーラの tag を、mise.toml の chezmoi と同じグループ PR で更新する",
      "managerFilePatterns": [
        "/^\\.github/workflows/chezmoi\\.yaml$/",
        "/^docker/Dockerfile\\.debian$/",
        "/^docker/Dockerfile\\.alpine$/"
      ],
      "matchStrings": [
        "get\\.chezmoi\\.io\\)\" -- -b \"\\$HOME/\\.local/bin\" -t v(?<currentValue>[\\d.]+)",
        "get\\.chezmoi\\.io/ps1'\\)} -b '\\$chezmoiBin' -t 'v(?<currentValue>[\\d.]+)'"
      ],
      "depNameTemplate": "twpayne/chezmoi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)"
    },
    {
      "customType": "regex",
      "description": "`# renovate: datasource= depName= [packageName=] [versioning=] [extractVersion=]` 注釈の直下の `key = \"version\"` 行を更新する。java-version datasource は temurin- prefix の無い版を返すので、prefix を currentValue の外に置く",
      "managerFilePatterns": [
        "/^home/\\.chezmoidata\\.toml$/",
        "/^mise\\.toml$/",
        "/^home/dot_config/mise/config\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z.-]+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n\"?[A-Za-z0-9_.:/@-]+\"? = \"(?:temurin-)?(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "workflow の container.image (digest pin + バージョンコメント) を更新する。組み込みの github-actions manager は digest しか更新せず、バージョンコメントが古いまま残る",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[a-z0-9./_-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\s+#\\s+(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "dprint.json の公式プラグインの WASM URL を更新する。@ 以降の sha256 は release asset (plugin.wasm) の実ハッシュで追従させる",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>[a-z0-9-]+)-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "dprint.json の g-plane プラグインの WASM URL を更新する (tag の v prefix を含めて照合する)",
      "managerFilePatterns": [
        "/(^|/)dprint\\.json$/"
      ],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/g-plane/(?<depName>[a-z0-9_-]+)-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm(?:@(?<currentDigest>[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "g-plane/{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Docker のベースイメージを更新する (docker-image-cd / docker workflow の base:、mise.toml の build-<tag> タスク、Dockerfile の ARG BASE_IMAGE)",
      "managerFilePatterns": [
        "/^\\.github/workflows/docker-image-cd\\.yaml$/",
        "/^\\.github/workflows/docker\\.yaml$/",
        "/^mise\\.toml$/",
        "/^docker/Dockerfile\\.debian$/",
        "/^docker/Dockerfile\\.alpine$/"
      ],
      "matchStrings": [
        "base: (?<depName>[^:]+):(?<currentValue>[^\\s]+)\\n",
        "mise run docker-build [a-z-]+ (?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+) ",
        "ARG BASE_IMAGE=(?<depName>[a-z0-9./_-]+):(?<currentValue>[\\w.-]+)\\n"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の Nerd Fonts の release zip (SourceCodePro / NerdFontsSymbolsOnly) を同じバージョンで一括更新する",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "nerd-fonts/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^install/windows/setup_powershell\\.ps1$/"
      ],
      "matchStrings": [
        "\\$NerdFontsVersion = '(?<currentValue>v[\\d.]+)'\\n"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "pre-commit hook の rev (SHA pin + `# frozen:` コメント) を更新する。組み込みの pre-commit manager は frozen 形式に未対応 (renovate#22567)",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "repo: https://github\\.com/(?<depName>[^\\s]+)\\n\\s+rev: (?<currentDigest>[a-f0-9]{40}) # frozen: (?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の dracula/vim の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/vim/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/vim",
      "packageNameTemplate": "https://github.com/dracula/vim",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の dracula/delta の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/delta/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/delta",
      "packageNameTemplate": "https://github.com/dracula/delta",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の dracula/tmux の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/tmux/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/tmux",
      "packageNameTemplate": "https://github.com/dracula/tmux",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の dracula/dircolors の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/dracula/dircolors/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "dracula/dircolors",
      "packageNameTemplate": "https://github.com/dracula/dircolors",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の git-open の commit SHA を master の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/paulirish/git-open/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "paulirish/git-open",
      "packageNameTemplate": "https://github.com/paulirish/git-open",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の dracula/ghostty の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dracula/ghostty/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "dracula/ghostty",
      "packageNameTemplate": "https://github.com/dracula/ghostty",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の dracula/xcode の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dracula/xcode/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "dracula/xcode",
      "packageNameTemplate": "https://github.com/dracula/xcode",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の powerline/fonts の commit SHA を default branch の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "github\\.com/powerline/fonts/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz"
      ],
      "depNameTemplate": "powerline/fonts",
      "packageNameTemplate": "https://github.com/powerline/fonts",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "chezmoi external の source-han-code-jp を更新する。フォントのリリースは R 付きタグだけ (無印はソースのリリース) なので R 付きに限る",
      "managerFilePatterns": [
        "/^home/\\.chezmoitemplates/external-fonts\\.toml$/"
      ],
      "matchStrings": [
        "source-han-code-jp/archive/refs/tags/(?<currentValue>[\\d.]+R)\\.zip"
      ],
      "depNameTemplate": "adobe-fonts/source-han-code-jp",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>[\\d.]+R)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "setup-mise action の mise 本体のバージョン pin を更新する",
      "managerFilePatterns": [
        "/^\\.github/actions/setup-mise/action\\.yml$/"
      ],
      "matchStrings": [
        "default: \"(?<currentValue>[\\d.]+)\"\\n"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)"
    },
    {
      "customType": "regex",
      "description": "壁紙 URL の dracula/wallpaper の commit SHA を master の最新 commit に追従させる",
      "managerFilePatterns": [
        "/^install/macos/system_settings\\.sh$/",
        "/^install/ubuntu/system_settings\\.sh$/"
      ],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/dracula/wallpaper/(?<currentDigest>[a-f0-9]{40})/"
      ],
      "depNameTemplate": "dracula/wallpaper",
      "packageNameTemplate": "https://github.com/dracula/wallpaper",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    }
  ]
}
