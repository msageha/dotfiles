      ],
      "depNameTemplate": "golang/go",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^go(?<version>\\S+)"
    },
    {
      "customType": "regex",
      "description": "java-version datasource は temurin- prefix なしの semver (例: 26.0.1+8) を返すため、prefix は currentValue の外に置いて照合する (Renovate 本体の asdf manager と同じ扱い)",
      "managerFilePatterns": [
        "/^home/dot_config/mise/config\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "java = \"temurin-(?<currentValue>[^\"]+)\"\\n"
