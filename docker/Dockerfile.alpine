# syntax=docker/dockerfile:1.28
ARG BASE_IMAGE=alpine:3.24
FROM ${BASE_IMAGE}

ENV DOCKER_MACHINE_NAME="msageha-docker"
# DL3064 は変数名の "username" だけで機微情報とみなすため抑制する (値はログインユーザー名)
# hadolint ignore=DL3064
ARG USERNAME=mzk
ENV USER=${USERNAME}
ENV TZ=Asia/Tokyo
ENV HOME=/home/${USERNAME}
# chezmoi data の skip_cli_tools / skip_gui_tools に渡す。true で最小構成
ARG SKIP_CLI_TOOLS=true
ARG SKIP_GUI_TOOLS=true

# ここでは chezmoi apply に要る最小限だけを入れる。CLI ツール・shell・git 等は apply 中に
# install/alpine/apk.sh が入れる。bash は chezmoi スクリプトの #!/bin/bash 用。
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
RUN \
  apk add --no-cache \
  bash \
  ca-certificates \
  curl \
  sudo \
  tzdata && \
  # tzdata は消さない。musl は ENV TZ を /usr/share/zoneinfo で解決し、無いと UTC になる
  # (/etc/localtime のコピーだけでは足りない)。shadow (groupadd / useradd / chpasswd) はユーザー作成後に消す。
  apk add --no-cache --virtual .build-deps shadow && \
  cp "/usr/share/zoneinfo/${TZ}" /etc/localtime && \
  echo "${TZ}" > /etc/timezone && \
  groupadd "${USERNAME}" && \
  useradd -g "${USERNAME}" -G wheel -m -s /bin/bash "${USERNAME}" && \
  echo "${USERNAME}:${USERNAME}" | chpasswd && \
  echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
  apk del .build-deps

# musl には locale-gen が無く ja_JP.UTF-8 は生成できないが、musl は常に UTF-8 で扱うので
# LANG / LC_ALL を設定すれば UTF-8 の入出力は動く。
ENV LANG=ja_JP.UTF-8
ENV LANGUAGE=ja_JP:ja
ENV LC_ALL=ja_JP.UTF-8

WORKDIR $HOME

COPY --chown=${USERNAME}:${USERNAME} ./ ./dotfiles/

USER ${USERNAME}

# github_token は GitHub API のレート制限を避けるための token。BuildKit の secret は既定で root 所有 0400 で、
# 非 root ユーザーが読めないと匿名枠で 403 になるので mode=0444 にする。
# GITHUB_TOKEN ではなく MISE_GITHUB_TOKEN で渡し、GITHUB_TOKEN を読む第三者のインストーラ (curl | sh) や gh に
# 使わせない (子プロセスへは継承されるので隔離ではない)。
# DL3004: sudo は USER 切替後の strip 用 binutils の出し入れにだけ使う
# hadolint ignore=DL3004
RUN --mount=type=secret,id=github_token,mode=0444,required=false \
  if [ -f /run/secrets/github_token ]; then MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)" && export MISE_GITHUB_TOKEN; fi && \
  sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin" -t v2.73.2 && \
  export PATH="$HOME/.local/bin:$PATH" && \
  mkdir -p "$HOME/.config/chezmoi" && \
  printf '%s\n' \
  '[data]' \
  "skip_cli_tools = ${SKIP_CLI_TOOLS}" \
  "skip_gui_tools = ${SKIP_GUI_TOOLS}" \
  > "$HOME/.config/chezmoi/chezmoi.toml" && \
  chezmoi apply --source="$HOME/dotfiles" && \
  rm -rf "$HOME/dotfiles" "$HOME/.cache" && \
  # java の src.zip はランタイムに要らない
  rm -f "$HOME/.local/share/mise/installs/java/"*/lib/src.zip && \
  # chezmoi は provisioning にしか使わない (再適用するなら get.chezmoi.io で入れ直す)
  rm -f "$HOME/.local/bin/chezmoi" && \
  # mise.run が入れる mise は strip されていない。binutils は strip のためだけに入れて消す
  sudo apk add --no-cache --virtual .strip-deps binutils && \
  strip "$HOME/.local/bin/mise" && \
  sudo apk del .strip-deps

CMD ["/usr/bin/fish"]
