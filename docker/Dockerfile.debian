# syntax=docker/dockerfile:1.27
ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}

ENV DOCKER_MACHINE_NAME="msageha-docker"
ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS=yes
# DL3064 は変数名に "username" を含むだけで機微情報とみなすため、
# コンテナのログインユーザー名を渡すこの ARG では抑制する
# hadolint ignore=DL3064
ARG USERNAME=mzk
ENV USER=${USERNAME}
ENV TZ=Asia/Tokyo
ENV HOME=/home/${USERNAME}
# chezmoi のツール導入レベルを制御するビルド引数。
# SKIP_CLI_TOOLS=true で最小構成
ARG SKIP_CLI_TOOLS=true
ARG SKIP_GUI_TOOLS=true

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN \
  apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates locales tzdata sudo curl && \
  apt-get autoremove -y && \
  apt-get clean && \
  rm -rf /var/lib/apt/lists/* && \
  echo "ja_JP.UTF-8 UTF-8" >> /etc/locale.gen && \
  locale-gen && \
  update-locale LANG=ja_JP.UTF-8 LANGUAGE=ja_JP:ja && \
  echo "${TZ}" > /etc/timezone && \
  rm /etc/localtime && \
  ln -s /usr/share/zoneinfo/${TZ} /etc/localtime && \
  dpkg-reconfigure -f noninteractive tzdata && \
  if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi && \
  groupadd ${USERNAME} && \
  useradd -g ${USERNAME} -G sudo -m -s /bin/bash ${USERNAME} && \
  echo "${USERNAME}:${USERNAME}" | chpasswd && \
  echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ロケールは上の RUN で生成済み。生成より前に LANG/LC_ALL を設定すると
# 未生成ロケールを指した状態になり Ubuntu の locale-gen が何も生成しないため、
# ここ (生成後) で初めて環境変数として設定する。
ENV LANG=ja_JP.UTF-8
ENV LANGUAGE=ja_JP:ja
ENV LC_ALL=ja_JP.UTF-8

WORKDIR $HOME

COPY --chown=${USERNAME}:${USERNAME} ./ ./dotfiles/

USER ${USERNAME}

# secret は BuildKit 既定で root 所有 0400 のため、非 root ユーザーが読めるよう mode=0444 を指定する
# (GitHub のレート制限回避用トークン。未指定だと cat が権限拒否され匿名枠で 403 になる)。
# 汎用の GITHUB_TOKEN ではなく mise 専用変数で渡し、GITHUB_TOKEN を参照する第三者の
# インストーラ (curl | sh) や gh が gh のフルスコープ token を使わないようにする
# (環境変数自体は子プロセスへ継承されるため、隔離ではない)。
# DL3004: USER 切替後の掃除 (strip 用 binutils の出し入れ) にだけ sudo を使う
# hadolint ignore=DL3004
RUN --mount=type=secret,id=github_token,mode=0444,required=false \
  if [ -f /run/secrets/github_token ]; then MISE_GITHUB_TOKEN="$(cat /run/secrets/github_token)" && export MISE_GITHUB_TOKEN; fi && \
  sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin" -t v2.72.2 && \
  export PATH="$HOME/.local/bin:$PATH" && \
  mkdir -p "$HOME/.config/chezmoi" && \
  printf '%s\n' \
  '[data]' \
  "skip_cli_tools = ${SKIP_CLI_TOOLS}" \
  "skip_gui_tools = ${SKIP_GUI_TOOLS}" \
  > "$HOME/.config/chezmoi/chezmoi.toml" && \
  chezmoi apply --source="$HOME/dotfiles" && \
  rm -rf "$HOME/dotfiles" "$HOME/.cache" && \
  # java が導入されるビルド変種では src.zip を落とす
  rm -f "$HOME/.local/share/mise/installs/java/"*/lib/src.zip && \
  # chezmoi は provisioning 専用でランタイム不要。~42MB あるため apply 後に削除する
  # (再適用が必要なら curl get.chezmoi.io で都度入れ直す)。
  rm -f "$HOME/.local/bin/chezmoi" && \
  # mise.run が入れるバイナリは strip されておらず ~83MB ある。binutils を一時導入して
  # strip し (~70MB に縮む)、binutils はランタイムに残さず削除する。
  sudo apt-get update && \
  sudo apt-get install -y --no-install-recommends binutils && \
  strip "$HOME/.local/bin/mise" && \
  sudo apt-get purge -y binutils && \
  sudo apt-get autoremove -y && \
  sudo apt-get clean && \
  sudo rm -rf /var/lib/apt/lists/*

CMD ["/usr/bin/fish"]
